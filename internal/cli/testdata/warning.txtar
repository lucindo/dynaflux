A stream kept forever, which gets warning DF2501.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
-- dynaflux/page_views.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id)
LOG RETENTION FOREVER;
