The store of TestStatus, deployed in us-east-1 and us-west-2, and under want/ what each case
prints (go test -update rewrites them). Both regions archive both streams with events: all.
page_counts and plan_counts count, so a table source splits them by time; page_seen is
idempotent.
-- dynaflux.yaml --
store: shop
regions: [us-east-1, us-west-2]
archive: {enabled: true, events: all}
-- dynaflux/shop.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);

CREATE STREAM signups (user_id String, plan String)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW page_counts
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;

CREATE MATERIALIZED VIEW page_seen
ORDER BY (page)
AS SELECT page, max(user_id) AS last_user
FROM page_views
GROUP BY page;

CREATE MATERIALIZED VIEW plan_counts
ORDER BY (plan)
AS SELECT plan, count() AS signups
FROM signups
GROUP BY plan;
