The deployed store of TestImport, and the files it imports.
-- dynaflux.yaml --
store: shop
regions: [us-east-1, us-west-2]
-- dynaflux/shop.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    duration_ms UInt32,
    tags        Array(String) DEFAULT [],
    referrer    Nullable(String)
)
PRIMARY KEY (user_id);

CREATE STREAM payments (account String, payment_id UUID, amount Decimal(10, 2))
PRIMARY KEY (account)
DEDUP BY (payment_id);

CREATE STREAM typed (
    id    String,
    u8    UInt8,
    u16   UInt16,
    u32   UInt32,
    u64   UInt64,
    i8    Int8,
    i16   Int16,
    i32   Int32,
    i64   Int64,
    f     Float64,
    d     Decimal(10, 2),
    b     Bool,
    u     UUID,
    day   Date,
    ms    DateTime64(3),
    tags  Array(LowCardinality(String)),
    nums  Array(Int32),
    note  Nullable(String)
)
PRIMARY KEY (id);

CREATE MATERIALIZED VIEW page_hourly
ORDER BY (page, hour)
PRIMARY KEY (page)
AS SELECT page, toStartOfHour(ingest_time) AS hour, count() AS views
FROM page_views
GROUP BY page, hour;

CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;
