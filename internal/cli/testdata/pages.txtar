A page-views project without diagnostics.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
-- dynaflux/streams/page_views.sql --
CREATE STREAM page_views (user_id String, page String, duration_ms UInt32)
PRIMARY KEY (user_id);
-- dynaflux/views/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views, uniqExact(user_id) AS visitors
FROM page_views
GROUP BY page, day;
-- dynaflux/queries/pages.sql --
-- name: PageStats :many
SELECT day, views, visitors
FROM page_daily
WHERE page = {page:String} AND day BETWEEN {from:Date} AND {to:Date}
ORDER BY day;
