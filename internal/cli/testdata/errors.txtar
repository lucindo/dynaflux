A view whose FROM misspells the stream, and a view over a Float64 sum, which gets a
warning.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
-- dynaflux/page_views.sql --
CREATE STREAM page_views (user_id String, page String, seconds Float64)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_view
GROUP BY page, day;

CREATE MATERIALIZED VIEW page_seconds
ORDER BY (page)
AS SELECT page, sum(seconds) AS total_seconds
FROM page_views
GROUP BY page;
