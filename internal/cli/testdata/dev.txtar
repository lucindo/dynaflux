The project of the dev tests. next/shop.sql is its SQL after a change, which
TestDevRestart copies over dynaflux/shop.sql: a new version of an additive view and
of an idempotent one, a new view on page_views, and a new stream with a view.
-- dynaflux.yaml --
store: devshop
regions: [us-east-1]
-- dynaflux/shop.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    duration_ms UInt32
)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;

CREATE MATERIALIZED VIEW page_users
ORDER BY (page)
PRIMARY KEY (page)
AS SELECT page, uniqExact(user_id) AS visitors, max(duration_ms) AS longest
FROM page_views
GROUP BY page;

-- name: PageStats :many
SELECT day, views FROM page_daily WHERE page = {page:String} ORDER BY day;

-- name: PageUsers :one
SELECT visitors, longest FROM page_users WHERE page = {page:String};
-- next/shop.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    duration_ms UInt32
)
PRIMARY KEY (user_id);

CREATE STREAM clicks (button String)
PRIMARY KEY (button);

CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views, sum(duration_ms) AS total_ms
FROM page_views
GROUP BY page, day;

CREATE MATERIALIZED VIEW page_users
ORDER BY (page)
PRIMARY KEY (page)
AS SELECT page, uniqExact(user_id) AS visitors, max(duration_ms) AS longest, min(duration_ms) AS shortest
FROM page_views
GROUP BY page;

CREATE MATERIALIZED VIEW user_pages
ORDER BY (user_id)
PRIMARY KEY (user_id)
AS SELECT user_id, count() AS views
FROM page_views
GROUP BY user_id;

CREATE MATERIALIZED VIEW button_clicks
ORDER BY (button)
PRIMARY KEY (button)
AS SELECT button, count() AS clicks
FROM clicks
GROUP BY button;

-- name: PageStats :many
SELECT day, views, total_ms FROM page_daily WHERE page = {page:String} ORDER BY day;

-- name: PageUsers :one
SELECT visitors, longest, shortest FROM page_users WHERE page = {page:String};

-- name: UserViews :one
SELECT views FROM user_pages WHERE user_id = {user:String};

-- name: Clicks :one
SELECT clicks FROM button_clicks WHERE button = {button:String};
