The project of TestDiff, which deploys its catalog to us-east-1 and us-west-2 with every
version live, and under want/ what each case prints (go test -update rewrites them). Each
case then changes the project or what is deployed.
-- dynaflux.yaml --
store: shop
regions: [us-east-1, us-west-2]
archive: {enabled: true, events: all, regions: [us-east-1]}
-- dynaflux/shop.sql --
CREATE STREAM page_views (
    user_id  String,
    page     String,
    duration UInt32,
    source   String DEFAULT 'web',
    tag      Nullable(String),
    country  String
)
PRIMARY KEY (user_id);

CREATE STREAM signups (user_id String, plan String)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW page_counts
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;

CREATE MATERIALIZED VIEW page_seen
ORDER BY (page)
AS SELECT page, max(user_id) AS last_user
FROM page_views
GROUP BY page;

CREATE MATERIALIZED VIEW plan_counts
ORDER BY (plan)
AS SELECT plan, count() AS signups
FROM signups
GROUP BY plan;

-- name: PageViews :many
SELECT page, views FROM page_counts WHERE page = {page:String};

-- name: Plans :many
SELECT plan, signups FROM plan_counts WHERE plan = {plan:String};
