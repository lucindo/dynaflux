us-east-1, us-west-2: catalog 6779c712f696, local ecccd95ebe0b
  stream page_views: primary key changed
  stream page_views: column retyped: duration
  stream page_views: default changed: source
  stream page_views: column removed: referrer
  stream page_views: column added: tag
  stream page_views: column required: country
  stream signups: archive changed
  stream signups: archive stopped in us-west-2
  stream legacy: stream dropped
