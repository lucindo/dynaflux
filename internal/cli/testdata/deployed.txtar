The deployed store of TestDeployed, and under want/ what each case prints (go test -update
rewrites them).
-- dynaflux.yaml --
store: shop
regions: [us-east-1, us-west-2]
archive:
  streams:
    orders:
      enabled: false
-- dynaflux/shop.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    duration_ms UInt32,
    tags        Array(String) DEFAULT []
)
PRIMARY KEY (user_id);

CREATE STREAM visits (site UUID, day Date, kind UInt8, note String)
PRIMARY KEY (site, day, kind);

CREATE STREAM orders (order_id String, total Decimal(10, 2))
PRIMARY KEY (order_id);

CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
SPLIT 2
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    avg(duration_ms)         AS avg_ms
FROM page_views
GROUP BY page, day;

CREATE MATERIALIZED VIEW user_pages
ORDER BY (user_id)
PRIMARY KEY (user_id)
AS SELECT user_id, count() AS views
FROM page_views
GROUP BY user_id;

-- name: PageStats :many
SELECT day, views, visitors, avg_ms
FROM page_daily
WHERE page = {page:String} AND day BETWEEN {from:Date} AND {to:Date}
ORDER BY day;

-- name: DayViews :one
SELECT views FROM page_daily WHERE page = {page:String} AND day = {day:Date};

-- name: UserViews :many
SELECT user_id, views FROM user_pages WHERE user_id IN {users:Array(String)};

-- name: UserEvents :many
SELECT event_time, page, tags FROM page_views WHERE user_id IN {users:Array(String)} ORDER BY event_time;
