The store of TestBackfill, deployed in us-east-1 and us-west-2, and under want/ what each
case prints (go test -update rewrites them). page_counts counts, so a table source splits it
by time; page_seen is idempotent; signups has no events.
-- dynaflux.yaml --
store: shop
regions: [us-east-1, us-west-2]
archive: {enabled: true, events: all}
-- dynaflux/shop.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id)
LOG RETENTION 2 DAY;

CREATE STREAM signups (user_id String, plan String)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW page_counts
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;

CREATE MATERIALIZED VIEW page_seen
ORDER BY (page)
AS SELECT page, max(user_id) AS last_user
FROM page_views
GROUP BY page;

CREATE MATERIALIZED VIEW plan_counts
ORDER BY (plan)
AS SELECT plan, count() AS signups
FROM signups
GROUP BY plan;
