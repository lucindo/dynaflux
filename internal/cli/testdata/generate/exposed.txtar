A query annotated -- expose: http gets the query function's template, query.yaml.
-- go.mod --
module example.com/app
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String, duration_ms UInt32)
PRIMARY KEY (user_id);
-- dynaflux/queries.sql --
-- name: RecentPageViews :many
-- expose: http
SELECT page FROM page_views WHERE user_id = {user:String};
