infra.out holds a stack policy but no global.yaml, whose generated-file line would
cover it: generate refuses to overwrite it, and writes nothing.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String, duration_ms UInt32)
PRIMARY KEY (user_id);
-- infra/dynaflux/global.stack-policy.json --
{"Statement": []}
