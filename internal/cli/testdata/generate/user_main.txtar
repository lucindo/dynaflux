A main.go in runtime.out without the generated-code line is the user's: generate stops.
-- go.mod --
module example.com/app
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String, duration_ms UInt32)
PRIMARY KEY (user_id);
-- cmd/dynaflux-runtime/main.go --
package main

func main() {}
