        "fingerprint": "103c0e4208af6a651079b0de1b90f05f8be5ea65920f057405d86bd20f3fce77",
        "mode": "async",
        "stream": "page_views",
        "keys": [
          {
            "name": "page",
            "expr": {
              "op": "column",
              "type": "String",
              "name": "page"
            }
          },
          {
            "name": "day",
            "expr": {
              "op": "toStartOfDay",
              "type": "DateTime",
              "args": [
                {
                  "op": "column",
                  "type": "DateTime64(6)",
                  "name": "event_time"
                }
              ]
            }
          }
        ],
        "partition_key_len": 1,
        "split": 1,
        "aggregates": [
          {
            "fn": "sum",
            "args": [
              {
                "op": "column",
                "type": "UInt32",
                "name": "duration_ms"
              }
            ],
            "type": "UInt64",
            "name": "total_ms"
          },
          {
            "fn": "count",
            "type": "UInt64",
            "name": "views"
          }
        ],
        "storage_format": 1
      },
      {
        "number": 1,
        "state": "retired",
        "fingerprint": "1242f0a6792f3ab9edc9e9f6a438396eb1d3ff79c2876c0f18f39bce4ca88ed5"
      }
    ]
  }
}
