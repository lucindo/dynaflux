The SQL defines page_daily v1 again, but dynaflux retire retired v1, so the definition gets
a new number: a retired number never comes back.
-- go.mod --
module example.com/app
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String, duration_ms UInt32)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;
-- dynaflux.lock --
