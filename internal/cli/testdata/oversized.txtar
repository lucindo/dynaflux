costs.py's scenario B1: a log kept a year and a 25-hour prune window, so page_daily rows
keep a high-water mark for most of the stream's shards and outgrow DynamoDB's 400 KB item
limit. The project is valid, but explain reports an error.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
runtime:
  prune_window_seconds: 90000
-- dynaflux/page_views.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id)
LOG RETENTION 365 DAY;

CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;
