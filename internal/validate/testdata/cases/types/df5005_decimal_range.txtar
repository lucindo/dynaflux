Decimal needs 1 <= P <= 38 and 0 <= S <= P, and a precision.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id String,
    a Decimal(39, 2),
    b Decimal(5, 6),
    c Decimal(0),
    d Decimal
)
PRIMARY KEY (user_id);
-- want --
dynaflux/page_views.sql:3:7: error DF5005
