ClickHouse types that aren't in v1, including SQL aliases and DateTime as a declared
type.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id String,
    score   Float32,
    seen_at DateTime,
    born_on Date32,
    big     Int128,
    price   Decimal64(2),
    code    FixedString(2),
    attrs   Map(String, String),
    ip      IPv4,
    name    VARCHAR
)
PRIMARY KEY (user_id);
