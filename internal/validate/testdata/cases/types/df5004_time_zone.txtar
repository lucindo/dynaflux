DateTime64 takes no time zone other than UTC. The diagnostic points at the zone.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id String,
    at  DateTime64(3, 'Europe/Berlin'),
    utc DateTime64(6, 'UTC')
)
PRIMARY KEY (user_id);
-- want --
dynaflux/page_views.sql:3:23: error DF5004
