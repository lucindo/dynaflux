A merge lost the lock's rebuild counts, so the current version holds a count its view no
longer has.
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String, duration_ms UInt32)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;
