The SQL defines page_daily v1 again, but v1 is retired, so the definition gets a new
number, v3. Retired versions, and those of the dropped view page_hourly, stay in the lock
and the catalog lists them as retired.
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String, duration_ms UInt32)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;
-- dynaflux.lock --
