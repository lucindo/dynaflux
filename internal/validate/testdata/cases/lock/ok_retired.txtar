-- want-catalog --
{"catalog": {
  "views": [{"name": "page_daily", "versions": [
    {"number": 2, "state": "retained", "aggregates": [{"name": "total_ms"}, {"name": "views"}]},
    {"number": 3, "state": "current", "fingerprint": "1242f0a6792f3ab9edc9e9f6a438396eb1d3ff79c2876c0f18f39bce4ca88ed5",
     "aggregates": [{"name": "views"}]}
  ]}],
