Each GROUP BY item names a SELECT item. ORDER BY lists the GROUP BY items, so it adds
no error of its own.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_users
ORDER BY (page, user_id)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page, user_id;
-- want --
dynaflux/views.sql:5:16: error DF3005
