FROM names no stream. The view uses a constant key, so it reads no column that the
missing stream would have to define.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_totals
ORDER BY (scope)
AS SELECT 'all' AS scope, count() AS views
FROM page_view
GROUP BY scope;
-- want --
dynaflux/views.sql:4:6: error DF3001
