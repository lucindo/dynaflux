A view without MODE takes defaults.view_mode. When that is sync, the warning points at
the view's name.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
defaults:
  view_mode: sync
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;
-- want --
dynaflux/views.sql:1:26: warning DF3501
