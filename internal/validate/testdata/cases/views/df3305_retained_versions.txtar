    c42 String,
    c43 String,
    c44 String,
    c45 String,
    c46 String,
    c47 String,
    c48 String,
    c49 String,
    c50 String
)
PRIMARY KEY (k);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW wide_sync
MODE SYNC
ORDER BY (k)
AS SELECT
    k,
    count() AS n,
    uniqExact(c01) AS u01,
    uniqExact(c02) AS u02,
    uniqExact(c03) AS u03,
    uniqExact(c04) AS u04,
    uniqExact(c05) AS u05,
    uniqExact(c06) AS u06,
    uniqExact(c07) AS u07,
    uniqExact(c08) AS u08,
    uniqExact(c09) AS u09,
    uniqExact(c10) AS u10,
    uniqExact(c11) AS u11,
    uniqExact(c12) AS u12,
    uniqExact(c13) AS u13,
    uniqExact(c14) AS u14,
    uniqExact(c15) AS u15,
    uniqExact(c16) AS u16,
    uniqExact(c17) AS u17,
    uniqExact(c18) AS u18,
    uniqExact(c19) AS u19,
    uniqExact(c20) AS u20,
    uniqExact(c21) AS u21,
    uniqExact(c22) AS u22,
    uniqExact(c23) AS u23,
    uniqExact(c24) AS u24,
    uniqExact(c25) AS u25,
    uniqExact(c26) AS u26,
    uniqExact(c27) AS u27,
    uniqExact(c28) AS u28,
    uniqExact(c29) AS u29,
    uniqExact(c30) AS u30,
    uniqExact(c31) AS u31,
    uniqExact(c32) AS u32,
    uniqExact(c33) AS u33,
    uniqExact(c34) AS u34,
    uniqExact(c35) AS u35,
    uniqExact(c36) AS u36,
    uniqExact(c37) AS u37,
    uniqExact(c38) AS u38,
    uniqExact(c39) AS u39,
    uniqExact(c40) AS u40,
    uniqExact(c41) AS u41,
    uniqExact(c42) AS u42,
    uniqExact(c43) AS u43,
    uniqExact(c44) AS u44,
    uniqExact(c45) AS u45,
    uniqExact(c46) AS u46,
