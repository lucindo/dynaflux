ORDER BY lists exactly the GROUP BY keys: one view leaves out day, the other adds
user_id.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;

CREATE MATERIALIZED VIEW page_hourly
ORDER BY (page, hour, user_id)
AS SELECT page, toStartOfHour(event_time) AS hour, count() AS views
FROM page_views
GROUP BY page, hour;
-- want --
dynaflux/views.sql:2:1: error DF3101
dynaflux/views.sql:8:1: error DF3101
