A view without GROUP BY has no keys, so it has no ORDER BY either. Both clauses are
missing, so both diagnostics point at the statement's first token.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_totals
AS SELECT count() AS views
FROM page_views;
-- want --
dynaflux/views.sql:1:1: error DF3003
dynaflux/views.sql:1:1: error DF3007
