sum and avg over Float64 get one warning each; max over Float64 doesn't.
-- dynaflux/ratings.sql --
CREATE STREAM ratings (user_id String, item String, score Float64)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW item_scores
ORDER BY (item)
AS SELECT
    item,
    sum(score) AS total_score,
    avg(score) AS mean_score,
    max(score) AS best_score,
    count()    AS votes
FROM ratings
GROUP BY item;
-- want --
dynaflux/ratings.sql:8:5: warning DF3502
dynaflux/ratings.sql:9:5: warning DF3502
