A SYNC view whose GROUP BY lacks the stream's PRIMARY KEY column user_id gets a warning
at MODE.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
MODE SYNC
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;
-- want --
dynaflux/views.sql:2:1: warning DF3501
