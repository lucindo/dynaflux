A view's SELECT has no ORDER BY or LIMIT; the view's own ORDER BY clause sets the key
order.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_totals
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page
ORDER BY page;

CREATE MATERIALIZED VIEW page_top
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page
LIMIT 10;
-- want --
dynaflux/views.sql:6:1: error DF3006
dynaflux/views.sql:13:1: error DF3006
