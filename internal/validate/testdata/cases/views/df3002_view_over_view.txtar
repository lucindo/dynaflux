Views over views aren't supported.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_weekly
ORDER BY (scope)
AS SELECT 'all' AS scope, count() AS n
FROM page_daily
GROUP BY scope;
-- want --
dynaflux/views.sql:4:6: error DF3002
