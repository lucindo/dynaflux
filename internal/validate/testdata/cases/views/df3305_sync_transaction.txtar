An append writes the event, one row of the SYNC view and one marker per uniqExact: with
99 uniqExact aggregates that is 101 items, one over DynamoDB's limit. The diagnostic
points at the stream's name.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id String,
    page    String
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW user_pages
MODE SYNC
ORDER BY (user_id)
AS SELECT
    user_id,
    uniqExact(page) AS pages_01,
    uniqExact(page) AS pages_02,
    uniqExact(page) AS pages_03,
    uniqExact(page) AS pages_04,
