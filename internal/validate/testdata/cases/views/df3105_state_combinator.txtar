-State and -Merge aren't allowed in a view.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_totals
ORDER BY (page)
AS SELECT page, sumState(duration_ms) AS total_ms
FROM page_views
GROUP BY page;
-- want --
dynaflux/views.sql:3:17: error DF3105
