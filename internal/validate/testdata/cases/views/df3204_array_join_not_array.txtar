The ARRAY JOIN operand must be an Array.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_counts
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
ARRAY JOIN user_id AS uid
GROUP BY page;
-- want --
dynaflux/views.sql:5:12: error DF3204
