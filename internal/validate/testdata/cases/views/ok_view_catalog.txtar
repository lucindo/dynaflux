      },
      {
        "name": "item_daily",
        "versions": [
          {
            "number": 1,
            "state": "current",
            "mode": "async",
            "stream": "orders",
            "array_join": {"array": {"op": "column", "type": "Array(String)", "name": "items"}, "alias": "item"},
            "where": {"op": "greaterOrEquals", "type": "Bool", "args": [
              {"op": "toDate", "type": "Date", "args": [
                {"op": "column", "type": "DateTime64(6)", "name": "event_time"}
              ]},
              {"op": "literal", "type": "Date", "value": "2024-01-01"}
            ]},
            "keys": [
              {"name": "account_id", "expr": {"op": "column", "type": "String", "name": "account_id"}},
              {"name": "item", "expr": {"op": "column", "type": "String", "name": "item"}},
              {"name": "day", "expr": {"op": "toDate", "type": "Date", "args": [
                {"op": "column", "type": "DateTime64(6)", "name": "event_time"}
              ]}}
            ],
            "partition_key_len": 3,
            "ttl": null,
            "split": 4,
            "aggregates": [
              {"name": "best_region", "fn": "argMax", "type": "Nullable(String)", "args": [
                {"op": "column", "type": "String", "name": "region"},
                {"op": "column", "type": "Nullable(UInt16)", "name": "score"}
              ]},
              {"name": "median_qty", "fn": "quantile", "params": [0.5], "type": "Nullable(Float64)", "args": [
                {"op": "column", "type": "Int32", "name": "qty"}
              ]},
              {"name": "min_score", "fn": "min", "type": "Nullable(UInt16)", "args": [
                {"op": "column", "type": "Nullable(UInt16)", "name": "score"}
              ]},
              {"name": "p90_qty", "fn": "quantileDD", "params": [0.01, 0.9], "type": "Nullable(Float64)", "args": [
                {"op": "column", "type": "Int32", "name": "qty"}
              ]},
              {"name": "revenue", "fn": "sum", "type": "Decimal(38, 2)", "args": [
