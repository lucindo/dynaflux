SPLIT is from 2 to 16.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
SPLIT 1
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;

CREATE MATERIALIZED VIEW page_hourly
ORDER BY (page, hour)
SPLIT 17
AS SELECT page, toStartOfHour(event_time) AS hour, count() AS views
FROM page_views
GROUP BY page, hour;
-- want --
dynaflux/views.sql:3:1: error DF3306
dynaflux/views.sql:10:1: error DF3306
-- want-text --
dynaflux/views.sql:3:1: error DF3306: page_daily: SPLIT must be between 2 and 16
dynaflux/views.sql:10:1: error DF3306: page_hourly: SPLIT must be between 2 and 16
