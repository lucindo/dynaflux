IS NULL and IS NOT NULL need a Nullable operand: on any other, the result is fixed.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: NoViews :many
SELECT day
FROM page_daily
WHERE page = {page:String}
  AND views IS NULL;

-- name: SomeViews :many
SELECT day
FROM page_daily
WHERE page = {page:String}
  AND views IS NOT NULL;
-- want --
dynaflux/queries.sql:5:7: error DF5306
dynaflux/queries.sql:11:7: error DF5306
-- want-text --
dynaflux/queries.sql:5:7: error DF5306: NoViews: views is not Nullable, so IS NULL is always false
dynaflux/queries.sql:11:7: error DF5306: SomeViews: views is not Nullable, so IS NOT NULL is always true
