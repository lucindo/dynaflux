A number isn't a condition.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_totals
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
WHERE duration_ms
GROUP BY page;
-- want --
dynaflux/views.sql:5:7: error DF5302
