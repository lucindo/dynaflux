Decimal arithmetic with a float literal. The literal comes first, so the expression and
the Float64 operand start at the same place.
-- dynaflux/orders.sql --
CREATE STREAM orders (
    account_id String,
    order_id   UUID,
    price      Decimal(10, 2),
    rate       Decimal(38, 20)
)
PRIMARY KEY (account_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW account_gross
ORDER BY (account_id)
AS SELECT account_id, sum(1.1 * price) AS gross
FROM orders
GROUP BY account_id;
-- want --
dynaflux/views.sql:3:27: error DF5309
-- want-text --
dynaflux/views.sql:3:27: error DF5309: account_gross: can't combine Decimal and Float64
  hint: use Decimal values, and scale with integers: x * 11 / 10
