An unknown column. The hint suggests a visible name: one that differs only in letter case
(USER_ID), or else one within two edits (veiws, duraton_ms). In a view, aggregate arguments
see the source columns, and WHERE also the key aliases (dya). A double-quoted name also
gets the note that string literals use single quotes.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/page_totals.sql --
CREATE MATERIALIZED VIEW page_totals
ORDER BY (page, day)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    sum(duraton_ms)          AS total_ms,
    countIf(page = "home")   AS home_views
FROM page_views
WHERE USER_ID != '' AND dya >= '2024-05-01' AND page != "pages"
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: BusyDays :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND veiws > 10;
