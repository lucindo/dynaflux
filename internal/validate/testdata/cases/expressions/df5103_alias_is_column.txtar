An alias can't equal a column of the source, even the column it names.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: PageTotals :many
SELECT page, sum(views) AS views
FROM page_daily
WHERE page IN {pages:Array(String)}
GROUP BY page;

-- name: PageAsPage :many
SELECT page AS page, views
FROM page_daily
WHERE page = {page:String};
-- want --
dynaflux/queries.sql:2:28: error DF5103
dynaflux/queries.sql:8:16: error DF5103
