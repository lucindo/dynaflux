Comparisons don't chain. The diagnostic points at the second operator.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: MidDays :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND 0 < views < 10;
-- want --
dynaflux/queries.sql:5:17: error DF5304
-- want-text --
dynaflux/queries.sql:5:17: error DF5304: MidDays: comparisons can't be chained
  hint: combine them with AND, or add parentheses
