A comparison with NULL is never true. NULL is the comparison's first token, so the
comparison and the literal start at the same place.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: NoViews :many
SELECT day
FROM page_daily
WHERE page = {page:String}
  AND NULL = views;
-- want --
dynaflux/queries.sql:5:7: error DF5305
