Qualified names aren't supported, also for event_time in ACCEPT.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: BusyDays :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND page_daily.views > 10;
-- dynaflux/clicks.sql --
CREATE STREAM clicks (user_id String)
PRIMARY KEY (user_id)
ACCEPT clicks.event_time <= now() + INTERVAL 5 MINUTE;
-- want --
dynaflux/clicks.sql:3:8: error DF5102
dynaflux/queries.sql:5:7: error DF5102
-- want-text --
dynaflux/clicks.sql:3:8: error DF5102: clicks: qualified name clicks.event_time is not supported
  hint: use the column name alone
dynaflux/queries.sql:5:7: error DF5102: BusyDays: qualified name page_daily.views is not supported
  hint: use the column name alone
