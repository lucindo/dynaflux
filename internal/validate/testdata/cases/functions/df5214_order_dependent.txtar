Aggregates that depend on arrival order are DF5214.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_stats
ORDER BY (page)
AS SELECT
    page,
    anyLast(user_id) AS last_user,
    topK(10)(user_id) AS top_users
FROM page_views
GROUP BY page;
-- want --
dynaflux/views.sql:5:5: error DF5214
dynaflux/views.sql:6:5: error DF5214
