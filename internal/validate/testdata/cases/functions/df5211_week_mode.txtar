The toStartOfWeek mode is from 0 to 9.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: PageDays :many
SELECT day, toStartOfWeek(day, 10) AS week
FROM page_daily
WHERE page = {page:String};
-- want --
dynaflux/queries.sql:2:32: error DF5211
-- want-text --
dynaflux/queries.sql:2:32: error DF5211: PageDays: toStartOfWeek mode must be a whole number from 0 to 9
  hint: 0 starts weeks on Sunday, 1 on Monday
