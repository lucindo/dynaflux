Time zone arguments are errors. The diagnostic points at the argument.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: PageDays :many
SELECT day, toStartOfMonth(day, 'UTC') AS month
FROM page_daily
WHERE page = {page:String};
-- want --
dynaflux/queries.sql:2:33: error DF5210
-- want-text --
dynaflux/queries.sql:2:33: error DF5210: PageDays: time zone arguments are not supported
  hint: all times are UTC; remove the argument
