Combinators other than -If are DF5206.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_stats
ORDER BY (page)
AS SELECT
    page,
    sumOrNull(duration_ms) AS total_ms
FROM page_views
GROUP BY page;
-- want --
dynaflux/views.sql:5:5: error DF5206
