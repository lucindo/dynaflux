quantile takes a level from 0 to 1, and sum takes no parameter list.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_stats
ORDER BY (page)
AS SELECT
    page,
    quantile(1.5)(duration_ms) AS p150_ms,
    sum(1)(duration_ms) AS total_ms
FROM page_views
GROUP BY page;
-- want --
dynaflux/views.sql:5:5: error DF5205
dynaflux/views.sql:6:5: error DF5205
