11 pages times 10 days is 110 key combinations, over the limit of 100. The diagnostic
points at WHERE, which holds the key binding.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: TooManyPages :many
SELECT page, day, views
FROM page_daily
WHERE page IN ('/a', '/b', '/c', '/d', '/e', '/f', '/g', '/h', '/i', '/j', '/k')
  AND day IN ('2024-05-01', '2024-05-02', '2024-05-03', '2024-05-04', '2024-05-05', '2024-05-06', '2024-05-07', '2024-05-08', '2024-05-09', '2024-05-10');
-- want --
dynaflux/queries.sql:4:1: error DF4103
