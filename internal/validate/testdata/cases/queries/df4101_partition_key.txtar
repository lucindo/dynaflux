Every query binds the partition key with = or IN. Without such a term the diagnostic
points at WHERE, or at the name after FROM when there is no WHERE. Over a stream, the
partition key is the stream's PRIMARY KEY.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: PageStatsAnyPage :many
SELECT day, views
FROM page_daily
WHERE day >= {from:Date};

-- name: AllPages :many
SELECT page, views
FROM page_daily;

-- name: AllPageViews :many
SELECT event_time, page
FROM page_views
WHERE page = {page:String};
-- want --
dynaflux/queries.sql:4:1: error DF4101
dynaflux/queries.sql:8:6: error DF4101
dynaflux/queries.sql:12:6: warning DF4501
dynaflux/queries.sql:13:1: error DF4101
