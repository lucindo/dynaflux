:one needs a query that can't return more than one row; this one binds only the
partition key. The diagnostic points at the -- name: annotation.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: PageDays :one
SELECT day, views
FROM page_daily
WHERE page = {page:String};
-- want --
dynaflux/queries.sql:1:1: error DF4304
-- want-text --
dynaflux/queries.sql:1:1: error DF4304: PageDays: :one query can return more than one row
  hint: use :many, bind every view key with =, or add LIMIT 1
