The compiled form of four queries, worked out from sql.md §10:
- HourRange: an alias stands for its column, so s = binds the partition key site; = on day
  extends the sort prefix; two bounds on hour make the range; the term on clicks is the
  residual filter; ORDER BY a source column is followed by the view key as tie-breaker, in
  the direction of the last ORDER BY item.
- MonthlyClicks: a GROUP BY alias groups by its expression, which Columns and ORDER BY see
  by name; aggregates are numbered in order of appearance, -IfMerge merges a sumIf column,
  quantileMerge may change the level, and an expression over an aggregate is an output.
- ClickAt: event_time = v reads the one instant v, IS NOT NULL is residual, and LIMIT 1
  allows :one.
- PageClicks: page = v fixes the only GROUP BY key, so :one is allowed although page isn't
  a key of the stream.
The stream queries get DF4501.
-- dynaflux/clicks.sql --
CREATE STREAM clicks (
    site     String,
    page     String,
    referrer Nullable(String),
    ms       UInt32
)
PRIMARY KEY (site);
-- dynaflux/site_hourly.sql --
CREATE MATERIALIZED VIEW site_hourly
ORDER BY (site, day, hour)
PRIMARY KEY (site)
AS SELECT
    site,
    toDate(event_time)        AS day,
    toStartOfHour(event_time) AS hour,
    count()                   AS clicks,
    sumIf(ms, page != '')     AS page_ms,
    quantile(0.9)(ms)         AS p90_ms
FROM clicks
GROUP BY site, day, hour;
-- dynaflux/queries.sql --
-- name: HourRange :many
SELECT site AS s, hour, clicks
FROM site_hourly
WHERE s = {site:String}
  AND day = {day:Date}
  AND hour > {after:DateTime64(6)}
  AND hour <= {until:DateTime64(6)}
  AND clicks >= 10
ORDER BY page_ms DESC NULLS FIRST
LIMIT 5;

-- name: MonthlyClicks :many
SELECT
    toStartOfMonth(day)                   AS month,
    sum(clicks)                           AS total,
    sumIfMerge(page_ms)                   AS ms,
    quantileMerge(0.5)(p90_ms)            AS median_p90,
    if(sum(clicks) > 1000, 'hot', 'cold') AS heat
FROM site_hourly
WHERE site = {site:String}
GROUP BY month
ORDER BY month DESC;

-- name: ClickAt :one
SELECT page, referrer
FROM clicks
WHERE site = {site:String}
  AND event_time = {at:DateTime64(6)}
  AND referrer IS NOT NULL
LIMIT 1;

-- name: PageClicks :one
SELECT page, count() AS n
FROM clicks
WHERE site = {site:String}
  AND page = {page:String}
GROUP BY page;
