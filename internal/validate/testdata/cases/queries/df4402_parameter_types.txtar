A parameter has one type per query. The diagnostic points at the later use. Both types
compare with day, so no other rule fires whichever type wins.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: PageWindow :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND day >= {from:Date}
  AND day < {from:DateTime64(6)};
-- want --
dynaflux/queries.sql:6:13: error DF4402
