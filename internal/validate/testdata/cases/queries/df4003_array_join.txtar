ARRAY JOIN isn't allowed in queries. The query reads a stream, which also gets DF4501.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: UserTags :many
SELECT page
FROM page_views
ARRAY JOIN tags AS tag
WHERE user_id = {user:String};
-- want --
dynaflux/queries.sql:3:6: warning DF4501
dynaflux/queries.sql:4:1: error DF4003
-- want-text --
dynaflux/queries.sql:3:6: warning DF4501: UserTags: reads stream page_views, which keeps events for 2 DAY after ingestion (LOG RETENTION). Older events are only in the archive.
  hint: query older events with Athena, or aggregate them in a view
dynaflux/queries.sql:4:1: error DF4003: UserTags: ARRAY JOIN is not allowed in queries
  hint: put the ARRAY JOIN in a view
