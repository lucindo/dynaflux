Two equality terms, or two lower bounds, on one key column are DF4102, at the second.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: TwoPages :many
SELECT day, views
FROM page_daily
WHERE page = '/a' AND page = '/b';

-- name: TwoLowerBounds :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND day >= {from:Date}
  AND day > {after:Date};
-- want --
dynaflux/queries.sql:4:23: error DF4102
dynaflux/queries.sql:11:7: error DF4102
