Nullable and LowCardinality parameters aren't allowed, also as an Array element. The
diagnostic points at the parameter's type.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: PageDays :many
SELECT day, views
FROM page_daily
WHERE page = {page:Nullable(String)}
  AND views > {floor:LowCardinality(String)}
  AND page IN {pages:Array(LowCardinality(String))};
-- want --
dynaflux/queries.sql:4:20: error DF4401
dynaflux/queries.sql:5:22: error DF4401
dynaflux/queries.sql:6:22: error DF4401
