Array columns can't be ordered.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: RecentTags :many
SELECT event_time, tags
FROM page_views
WHERE user_id = {user:String}
ORDER BY tags;
-- want --
dynaflux/queries.sql:3:6: warning DF4501
dynaflux/queries.sql:5:10: error DF4302
