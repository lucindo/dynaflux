A parameter right after IN must be an Array, and an Array parameter can't be an item of
an IN list.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: DaysInScalar :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND day IN {day:Date};

-- name: DaysInList :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND day IN ({days:Array(Date)});
-- want --
dynaflux/queries.sql:5:14: error DF4405
dynaflux/queries.sql:11:15: error DF4405
