A quantile over a quantile column takes a quantile of quantiles.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms,
    quantile(0.9)(duration_ms) AS p90_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: MedianP90 :one
SELECT quantile(0.5)(p90_ms) AS median_p90
FROM page_daily
WHERE page = {page:String};
-- want --
dynaflux/queries.sql:2:8: error DF4204
