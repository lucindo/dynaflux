A parameter's type is checked like any declared type before the parameter rules, so an
invalid type gets its own DF5xxx code, not DF4401 (sql.md §4.1).
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: BadTypes :many
SELECT day, views
FROM page_daily
WHERE page = {page:String}
  AND views > {a:Nullable(Strin)}
  AND views > {b:LowCardinality(UInt8)}
  AND views IN {c:Array(Array(UInt32))}
  AND views > {d:Nullable(String, String)}
  AND views IN {e:Nullable(Array(UInt32))}
  AND views IN {f:Array(Nullable(UInt32))};
-- want --
dynaflux/queries.sql:5:27: error DF5001
dynaflux/queries.sql:6:18: error DF5008
dynaflux/queries.sql:7:25: error DF5007
dynaflux/queries.sql:8:18: error DF5009
dynaflux/queries.sql:9:28: error DF5006
dynaflux/queries.sql:10:25: error DF5007
-- want-text --
dynaflux/queries.sql:5:27: error DF5001: BadTypes: unknown type Strin
  hint: did you mean String?
dynaflux/queries.sql:6:18: error DF5008: BadTypes: LowCardinality(UInt8) is not supported
  hint: LowCardinality works only with String
dynaflux/queries.sql:7:25: error DF5007: BadTypes: Array element type Array(UInt32) is not supported
  hint: elements are non-Nullable scalars
dynaflux/queries.sql:8:18: error DF5009: BadTypes: invalid type arguments for Nullable(String, String)
  hint: write them as in Decimal(10, 2), Array(String) or DateTime64(6)
dynaflux/queries.sql:9:28: error DF5006: BadTypes: Array(UInt32) can't be inside Nullable
  hint: write LowCardinality(Nullable(String)); for arrays, use [] instead of NULL
dynaflux/queries.sql:10:25: error DF5007: BadTypes: Array element type Nullable(UInt32) is not supported
  hint: elements are non-Nullable scalars
