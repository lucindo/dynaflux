uniq over a uniq column counts distinct estimates.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms,
    uniq(user_id)            AS approx_visitors
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: ApproxVisitors :one
SELECT uniq(approx_visitors) AS visitor_estimate
FROM page_daily
WHERE page = {page:String};
-- want --
dynaflux/queries.sql:2:8: error DF4203
