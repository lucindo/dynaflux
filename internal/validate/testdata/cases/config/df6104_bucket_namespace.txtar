me-south-1 and me-central-1 don't offer the S3 account regional namespace, in which
Dynaflux names its bucket.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, me-south-1, me-central-1]
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:2:22: error DF6104
dynaflux.yaml:2:34: error DF6104
