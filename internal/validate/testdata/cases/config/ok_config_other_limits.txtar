The other ends of the config ranges, with no diagnostics.
-- dynaflux.yaml --
store: a
regions: [us-west-2]
runtime:
  timeout_seconds: 1
  memory_mb: 128
  batching_window_seconds: 300
defaults:
  log_retention: 36525d
archive:
  regions: all
  events: local
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
