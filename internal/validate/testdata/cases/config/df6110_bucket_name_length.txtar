The bucket name holds the region: a 33-character store fits it in us-east-1, but the
bucket name in ap-northeast-1 is 64 characters long, over S3's 63.
-- dynaflux.yaml --
store: analytics-for-a-store-of-33-chars
regions: [us-east-1, ap-northeast-1]
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:1:8: error DF6110
