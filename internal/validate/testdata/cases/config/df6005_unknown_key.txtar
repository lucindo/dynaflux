Unknown keys are errors at every level. There is no explain section.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
explain:
  rate: 1000
runtime:
  memory: 512
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:3:1: error DF6005
dynaflux.yaml:6:3: error DF6005
