An http section without a query annotated -- expose: http generates no front door.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
http:
  auth: iam
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:4:3: warning DF6612
