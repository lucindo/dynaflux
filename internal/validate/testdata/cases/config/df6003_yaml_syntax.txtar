A tab can't indent YAML. The diagnostic points at the tab.
-- dynaflux.yaml --
store: analytics
	regions: [us-east-1]
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:2:1: error DF6003
