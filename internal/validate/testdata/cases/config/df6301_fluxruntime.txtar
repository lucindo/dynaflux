go.package can't be fluxruntime, the Dynaflux package that the runtime binary's main.go
imports.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
go:
  package: fluxruntime
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id String,
    page    String
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:4:12: error DF6301
-- want-text --
dynaflux.yaml:4:12: error DF6301: go.package is "fluxruntime": generated code, or code that uses it, imports a package of that name
  hint: use a short lowercase name such as flux
