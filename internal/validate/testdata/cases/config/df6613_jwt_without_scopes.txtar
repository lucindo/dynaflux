Without scopes, API Gateway passes any ID or access token for the audience.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
http:
  frontend: http_api
  auth: jwt
  jwt:
    issuer: https://cognito-idp.us-east-1.amazonaws.com/us-east-1_abc
    audience: [app-client-id]
-- dynaflux/page_counts.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW page_counts
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;
-- dynaflux/queries.sql --
-- name: PageCounts :one
-- expose: http
SELECT views FROM page_counts WHERE page = {page:String};
-- want --
dynaflux.yaml:7:5: warning DF6613
