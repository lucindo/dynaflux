        "state": "current",
        "fingerprint": "12d3e4ab21c38d3b1bc93a4896116ec96fa494bf3ea5fb4c9281a67b8fe7f8a6",
        "mode": "async",
        "stream": "page_views",
        "keys": [
          {
            "name": "page",
            "expr": {
              "op": "column",
              "type": "String",
              "name": "page"
            }
          }
        ],
        "partition_key_len": 1,
        "split": 1,
        "aggregates": [
          {
            "fn": "count",
            "type": "UInt64",
            "name": "views"
          }
        ],
        "storage_format": 1
      }
    ]
  }
}
