The lock holds version 9 of a view whose name has 237 characters, so a new definition
would be version 10: analytics-view-<view>-v10 has 256 characters, over DynamoDB's 255.
-- dynaflux/a.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW page_daily_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;
-- dynaflux.lock --
{
