Output paths can't leave or be the project root; the .. check comes before cleaning.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
go:
  out: ../flux
runtime:
  out: .
infra:
  out: internal/../infra
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
