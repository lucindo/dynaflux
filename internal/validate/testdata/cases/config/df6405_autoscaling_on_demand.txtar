autoscaling is set while capacity is on_demand. The diagnostic points at the
autoscaling value, the value at fault.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
defaults:
  autoscaling:
    read: {min: 5, max: 100}
    write: {min: 5, max: 100}
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:5:5: error DF6405
