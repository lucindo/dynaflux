Config values at the edges of their rules, with no diagnostics.
-- dynaflux.yaml --
store: analytics
prefix: staging-
regions: [us-east-1, ap-northeast-1]
sql: ["./dynaflux/**/*.sql"]
go:
  package: flux2
  out: internal/gen/flux
runtime:
  out: cmd/runtime
  arch: x86_64
  timeout_seconds: 900
  prune_window_seconds: 960
  memory_mb: 10240
  batching_window_seconds: 0
  split: stream
infra:
  out: deploy/infra
defaults:
  capacity: provisioned
  autoscaling:
    read: {min: 1, max: 1, target_percent: 20}
    write: {min: 1, max: 40000, target_percent: 90}
  view_mode: async
  log_retention: 24h
tables:
  page_views:
    capacity: on_demand
archive:
  catalog: glue
  regions: [us-east-1]
  events: all
http:
  frontend: rest_api
  auth: cognito
  cognito:
    user_pool_arn: arn:aws-us-gov:cognito-idp:us-gov-west-1:123456789012:userpool/us-gov-west-1_A1
    app_clients: [a]
  max_concurrency: 1
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;
-- dynaflux/queries.sql --
-- name: PageViews :one
-- expose: http
SELECT views FROM page_daily WHERE page = {page:String};
-- want --
