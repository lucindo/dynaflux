A 32-character store fills the bucket name in ap-northeast-1 to exactly 63 characters,
the tightest of the names that the store alone implies.
-- dynaflux.yaml --
store: analytics-for-a-store-of-32-char
regions: [ap-northeast-1]
-- dynaflux/e.sql --
CREATE STREAM e (user_id String)
PRIMARY KEY (user_id);
-- want --
