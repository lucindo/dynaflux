A string where a list is needed, and yes for a boolean.
-- dynaflux.yaml --
store: analytics
regions: us-east-1
archive:
  enabled: yes
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
