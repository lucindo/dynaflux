function_url has no custom domain. The diagnostic points at the domain value.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
http:
  domain:
    name: flux.example.com
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:5:5: error DF6605
