Integers outside their ranges: the Lambda limits, and 25 hours for the prune window.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
runtime:
  timeout_seconds: 901
  memory_mb: 64
  batching_window_seconds: 301
  prune_window_seconds: 90001
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
