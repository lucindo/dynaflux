allow_public: true does nothing unless auth is none. No query is exposed, so the http section
warns too.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
http:
  allow_public: true
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:4:3: warning DF6612
dynaflux.yaml:4:17: warning DF6604
