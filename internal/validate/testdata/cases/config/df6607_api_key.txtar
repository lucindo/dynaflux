auth: api_key is a warning. Warnings in dynaflux.yaml don't stop the SQL checks, so the
stream query gets its own warning.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
http:
  frontend: rest_api
  auth: api_key
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/queries.sql --
-- name: RecentPageViews :many
SELECT event_time, page
FROM page_views
WHERE user_id = {user:String};
-- want --
dynaflux.yaml:5:9: warning DF6607
dynaflux/queries.sql:3:6: warning DF4501
