A pattern can't end in /, have bad syntax or be empty.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
sql:
  - dynaflux/**/*.sql
  - dynaflux/
  - "dynaflux/[a-z.sql"
  - ""
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:5:5: error DF6202
dynaflux.yaml:6:5: error DF6202
dynaflux.yaml:7:5: error DF6202
