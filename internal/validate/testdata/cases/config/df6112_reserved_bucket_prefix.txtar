S3 reserves bucket names that start with sthree-, here made of the prefix and the store.
-- dynaflux.yaml --
store: analytics
prefix: sthree-
regions: [us-east-1]
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:1:8: error DF6112
