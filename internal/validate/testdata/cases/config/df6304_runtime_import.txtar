With go.out under pkg/internal, runtime.out must be under pkg/ to import it.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
go:
  out: pkg/internal/flux
runtime:
  out: cmd/runtime
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:6:8: error DF6304
