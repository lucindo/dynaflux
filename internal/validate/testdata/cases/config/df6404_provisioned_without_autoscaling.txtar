capacity: provisioned needs autoscaling. The diagnostic points at the capacity value.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
defaults:
  capacity: provisioned
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:4:13: error DF6404
