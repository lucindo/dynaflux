The Cognito user pool is named by its ARN.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
http:
  frontend: rest_api
  auth: cognito
  cognito:
    user_pool_arn: us-east-1_abc
    app_clients: [app-client-id]
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- want --
dynaflux.yaml:7:20: error DF6611
