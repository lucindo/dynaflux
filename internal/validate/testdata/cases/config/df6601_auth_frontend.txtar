function_url supports iam and none, not jwt.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
http:
  auth: jwt
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
