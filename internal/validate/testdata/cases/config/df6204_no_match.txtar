Every pattern must match a file. That error stops validate before it reads the SQL, so
the stream without PRIMARY KEY gets no DF2102.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-2]
sql:
  - dynaflux/**/*.sql
  - queries/*.sql
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);

CREATE STREAM clicks (user_id String);
-- want --
dynaflux.yaml:5:5: error DF6204
