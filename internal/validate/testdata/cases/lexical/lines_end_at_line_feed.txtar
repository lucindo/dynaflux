A line ends at a line feed, and the carriage return before it is ignored.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id String
)
PRIMARY KEY (user_id);

CREATE STREAM clicks (user_id String);
-- want --
dynaflux/page_views.sql:6:1: error DF2102
