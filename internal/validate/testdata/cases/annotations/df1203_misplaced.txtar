An annotation inside a statement, or after the last statement, is DF1203.
-- dynaflux/clicks.sql --
CREATE STREAM clicks (
    -- go:type Click
    user_id String
)
PRIMARY KEY (user_id);
-- dynaflux/page_views.sql --
CREATE STREAM page_views (user_id String)
PRIMARY KEY (user_id);

-- go:type PageView
-- want --
dynaflux/clicks.sql:2:5: error DF1203
dynaflux/page_views.sql:4:1: error DF1203
