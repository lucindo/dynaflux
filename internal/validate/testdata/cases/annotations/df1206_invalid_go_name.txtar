A name in an annotation must match [A-Z][A-Za-z0-9]*. The diagnostic points at the name.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (
    user_id     String,
    page        String,
    referrer    Nullable(String),
    tags        Array(String),
    duration_ms UInt32
)
PRIMARY KEY (user_id);
-- dynaflux/page_daily.sql --
CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT
    page,
    toStartOfDay(event_time) AS day,
    count()                  AS views,
    uniqExact(user_id)       AS visitors,
    sum(duration_ms)         AS total_ms
FROM page_views
GROUP BY page, day;
-- dynaflux/queries.sql --
-- name: page_stats :many
SELECT day, views
FROM page_daily
WHERE page = {page:String};
-- dynaflux/clicks.sql --
-- go:type click
CREATE STREAM clicks (user_id String)
PRIMARY KEY (user_id);
-- want --
dynaflux/clicks.sql:1:12: error DF1206
dynaflux/queries.sql:1:10: error DF1206
