Every operand of an operator or function is evaluated, left to right, so an evaluation
error wins over a NULL operand on either side, and coalesce evaluates the arguments after
the one it returns (sql.md §5.8). Each DEFAULT fails to compute.
-- dynaflux/defaults.sql --
CREATE STREAM defaults (
    user_id    String,
    null_first Float64 DEFAULT coalesce(if(false, 1.5, NULL) + 1e308 * 10, 0),
    null_last  Float64 DEFAULT coalesce(1e308 * 10 + if(false, 1.5, NULL), 0),
    returned   Float64 DEFAULT coalesce(if(true, 1.5, NULL), 1e308 * 10)
)
PRIMARY KEY (user_id);
-- want --
dynaflux/defaults.sql:3:24: error DF2004
dynaflux/defaults.sql:4:24: error DF2004
dynaflux/defaults.sql:5:24: error DF2004
