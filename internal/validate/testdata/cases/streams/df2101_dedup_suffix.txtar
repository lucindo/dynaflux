Stream names can't end with _dedup; ending with _dedups is fine.
-- dynaflux/page_views.sql --
CREATE STREAM page_views_dedup (user_id String)
PRIMARY KEY (user_id);

CREATE STREAM page_dedups (user_id String)
PRIMARY KEY (user_id);
-- want --
dynaflux/page_views.sql:1:15: error DF2101
