Float64 and Array columns can't be keys, in PRIMARY KEY or in DEDUP BY.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (user_id String, score Float64, tags Array(String))
PRIMARY KEY (user_id, score)
DEDUP BY (tags);
-- want --
dynaflux/page_views.sql:2:23: error DF2105
dynaflux/page_views.sql:3:11: error DF2105
