CONSISTENCY parses and is rejected, whatever the value.
-- dynaflux/page_views.sql --
CREATE STREAM page_views (user_id String)
PRIMARY KEY (user_id)
CONSISTENCY = 'strong';
-- want --
dynaflux/page_views.sql:3:1: error DF2108
-- want-text --
dynaflux/page_views.sql:3:1: error DF2108: page_views: CONSISTENCY is reserved for consistent streams (v3)
  hint: remove it; streams are eventually consistent across regions
