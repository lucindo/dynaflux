Names that are reserved words in Athena, and string defaults with quotes and control
characters.
-- dynaflux/order.sql --
CREATE STREAM order (
    date     Date,
    user     String,
    "select" UInt8 DEFAULT 1,
    "from"   Array(String) DEFAULT ['it''s', 'tab\there'],
    table    Nullable(String),
    "values" String DEFAULT 'line\nbreak'
)
PRIMARY KEY (user);
