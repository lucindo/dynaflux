-- want/page.create.sql --
CREATE TABLE `prod_analytics`.`page` (
  `event_id` string,
  `event_time` timestamp,
  `ingest_time` timestamp,
  `origin_region` string,
  `path` string,
  `_shard` string,
  `_seq` string,
  `_arrival` timestamp)
PARTITIONED BY (day(`event_time`))
LOCATION 's3://prod-analytics-123456789012-us-east-1-an/warehouse/prod_analytics/page/iceberg/'
TBLPROPERTIES ('table_type' = 'ICEBERG', 'format' = 'parquet', 'write_compression' = 'zstd')
-- want/page.dedup.sql --
CREATE OR REPLACE VIEW "prod_analytics"."page_dedup" AS
SELECT
  "event_id",
  "event_time",
  "ingest_time",
  "origin_region",
  "path"
FROM (
  SELECT *, row_number() OVER (
    PARTITION BY "event_time", "event_id" ORDER BY "_arrival", "_shard", "_seq") AS "_dedup_rn"
  FROM "prod_analytics"."page")
WHERE "_dedup_rn" = 1
-- want/page.partitions.sql --
SELECT CAST("partition"."event_time_day" AS varchar) AS "day", "record_count", "total_size"
FROM "prod_analytics"."page$partitions"
-- want/page.records --
{"event_id":"01JB8Z9X4Q7M3N2P5R6S8T0V1Y","event_time":0,"ingest_time":1761475202000000,"origin_region":"us-east-1","path":"/","_shard":"shardId-00000001761475200000-1a2b3c4d","_seq":"0000000000000000000049668893422340000000","_arrival":1761475200000000}
-- want/page.unload.sql --
UNLOAD (
  SELECT
    "event_id",
    CAST("event_time" AS varchar) AS "event_time",
    CAST("ingest_time" AS varchar) AS "ingest_time",
    "origin_region",
    "path",
    "_shard",
    "_seq",
    CAST("_arrival" AS varchar) AS "_arrival"
  FROM "prod_analytics"."page"
  WHERE "event_time" >= TIMESTAMP '2025-10-26 00:00:00.000000' AND "event_time" < TIMESTAMP '2025-10-26 06:00:00.123456')
TO 's3://prod-analytics-123456789012-us-east-1-an/backfill/daily_views@v2/1761436800000000/unload/plan-1-7d1c0e/1761436800000000-1761458400123456/0/'
WITH (format = 'JSON')
-- want/page_views.create.sql --
CREATE TABLE `prod_analytics`.`page_views` (
  `event_id` string,
  `event_time` timestamp,
  `ingest_time` timestamp,
  `origin_region` string,
  `path` string,
  `user_id` decimal(20,0),
  `referrer` string,
  `tags` array<string>,
  `amount` decimal(10,2),
  `clicks` bigint,
  `_shard` string,
  `_seq` string,
  `_arrival` timestamp)
PARTITIONED BY (day(`event_time`))
LOCATION 's3://prod-analytics-123456789012-us-east-1-an/warehouse/prod_analytics/page_views/iceberg/'
TBLPROPERTIES ('table_type' = 'ICEBERG', 'format' = 'parquet', 'write_compression' = 'zstd')
-- want/page_views.dedup.sql --
CREATE OR REPLACE VIEW "prod_analytics"."page_views_dedup" AS
SELECT
  "event_id",
  "event_time",
  "ingest_time",
  "origin_region",
  "path",
  "user_id",
  "referrer",
  coalesce("tags", ARRAY[]) AS "tags",
  "amount",
  coalesce("clicks", BIGINT '0') AS "clicks"
FROM (
  SELECT *, row_number() OVER (
    PARTITION BY "event_time", "event_id" ORDER BY "_arrival", "_shard", "_seq") AS "_dedup_rn"
  FROM "prod_analytics"."page_views")
WHERE "_dedup_rn" = 1
-- want/page_views.partitions.sql --
SELECT CAST("partition"."event_time_day" AS varchar) AS "day", "record_count", "total_size"
FROM "prod_analytics"."page_views$partitions"
