A stream with UInt64, Nullable, Array, Decimal and DEFAULT columns, and a second stream
whose name is a prefix of the first's.
-- dynaflux/streams.sql --
CREATE STREAM page_views (
    path     String,
    user_id  UInt64,
    referrer Nullable(String),
    tags     Array(String) DEFAULT [],
    amount   Decimal(10, 2),
    clicks   UInt32 DEFAULT 0
)
PRIMARY KEY (path);

CREATE STREAM page (
    path String
)
PRIMARY KEY (path);
