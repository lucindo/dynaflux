-- want/page_views.unload.sql --
UNLOAD (
  SELECT
    "event_id",
    CAST("event_time" AS varchar) AS "event_time",
    CAST("ingest_time" AS varchar) AS "ingest_time",
    "origin_region",
    "path",
    CAST("user_id" AS varchar) AS "user_id",
    "referrer",
    "tags",
    CAST("amount" AS varchar) AS "amount",
    CAST("clicks" AS varchar) AS "clicks",
    "_shard",
    "_seq",
    CAST("_arrival" AS varchar) AS "_arrival"
  FROM "prod_analytics"."page_views"
  WHERE "event_time" >= TIMESTAMP '2025-10-26 00:00:00.000000' AND "event_time" < TIMESTAMP '2025-10-26 06:00:00.123456')
TO 's3://prod-analytics-123456789012-us-east-1-an/backfill/daily_views@v2/1761436800000000/unload/plan-1-7d1c0e/1761436800000000-1761458400123456/0/'
WITH (format = 'JSON')
