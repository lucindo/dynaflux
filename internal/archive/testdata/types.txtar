-- want/types.create.sql --
CREATE TABLE `prod_analytics`.`types` (
  `event_id` string,
  `event_time` timestamp,
  `ingest_time` timestamp,
  `origin_region` string,
  `s` string,
  `lc` string,
  `u` string,
  `u8` int,
  `u16` int,
  `u32` bigint,
  `u64` decimal(20,0),
  `i8` int,
  `i16` int,
  `i32` int,
  `i64` bigint,
  `f` double,
  `d` decimal(38,10),
  `d0` decimal(5,0),
  `b` boolean,
  `day` date,
  `ms` timestamp,
  `us` timestamp,
  `n` bigint,
  `ad` array<decimal(10,2)>,
  `au` array<string>,
  `ab` array<boolean>,
  `ay` array<date>,
  `as8` array<int>,
  `ai64` array<bigint>,
  `af` array<double>,
  `at` array<timestamp>,
  `astr` array<string>,
  `_shard` string,
  `_seq` string,
  `_arrival` timestamp)
PARTITIONED BY (day(`event_time`))
LOCATION 's3://prod-analytics-123456789012-us-east-1-an/warehouse/prod_analytics/types/iceberg/'
TBLPROPERTIES ('table_type' = 'ICEBERG', 'format' = 'parquet', 'write_compression' = 'zstd')
-- want/types.dedup.sql --
CREATE OR REPLACE VIEW "prod_analytics"."types_dedup" AS
SELECT
  "event_id",
  "event_time",
  "ingest_time",
  "origin_region",
  "s",
  "lc",
  "u",
  "u8",
  "u16",
  "u32",
  "u64",
  "i8",
  "i16",
  "i32",
  "i64",
  "f",
  "d",
  "d0",
  "b",
  "day",
  "ms",
  "us",
  "n",
  "ad",
  "au",
  "ab",
  "ay",
  "as8",
  "ai64",
  "af",
  "at",
  "astr"
FROM (
  SELECT *, row_number() OVER (
    PARTITION BY "event_time", "event_id" ORDER BY "_arrival", "_shard", "_seq") AS "_dedup_rn"
  FROM "prod_analytics"."types")
WHERE "_dedup_rn" = 1
