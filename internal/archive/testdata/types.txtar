One column of each type, with the values at the edges of each type's encoding: integers a
double can't hold, decimals with every digit, floats in exponent form, times at the ends
of their range, and strings that JSON must escape.
-- dynaflux/types.sql --
CREATE STREAM types (
    s    String,
    lc   LowCardinality(String),
    u    UUID,
    u8   UInt8,
    u16  UInt16,
    u32  UInt32,
    u64  UInt64,
    i8   Int8,
    i16  Int16,
    i32  Int32,
    i64  Int64,
    f    Float64,
    d    Decimal(38, 10),
    d0   Decimal(5, 0),
    b    Bool,
    day  Date,
    ms   DateTime64(3),
    us   DateTime64(6),
    n    Nullable(Int64),
    ad   Array(Decimal(10, 2)),
    au   Array(UUID),
    ab   Array(Bool),
    ay   Array(Date),
    as8  Array(UInt8),
    ai64 Array(Int64),
    af   Array(Float64),
    at   Array(DateTime64(6)),
    astr Array(String)
)
PRIMARY KEY (s);
