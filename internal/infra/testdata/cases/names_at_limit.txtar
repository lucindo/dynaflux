prefix and store take all 32 characters that the bucket name in ap-northeast-1 leaves
them, so the Prefix parameter allows no longer prefix. The streams a_1 and a__b and the
view v_2 have names whose IDs need a hash.
-- dynaflux.yaml --
store: analytics-at-the-limit-x
prefix: staging-
regions: [us-east-1, ap-northeast-1]
archive:
  enabled: false
-- dynaflux/streams.sql --
CREATE STREAM a_1 (user_id String, page String)
PRIMARY KEY (user_id)
LOG RETENTION FOREVER;

CREATE STREAM a__b (user_id String)
PRIMARY KEY (user_id)
LOG RETENTION FOREVER;
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW v_2
ORDER BY (page)
PRIMARY KEY (page)
AS SELECT page, count() AS views
FROM a_1
GROUP BY page;
-- want/global.stack-policy.json --
{
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "Update:*",
      "Principal": "*",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": "Update:Replace",
      "Principal": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ResourceType": [
            "AWS::DynamoDB::GlobalTable"
          ]
        }
      }
    }
  ]
}
