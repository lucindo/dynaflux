      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: stream
      - Key: dynaflux:name
        Value: a__b
      - Key: dynaflux:store
        Value: analytics-at-the-limit-x
  Dashboard:
    Type: AWS::CloudWatch::Dashboard
    Properties:
      DashboardName: !Sub ${Prefix}analytics-at-the-limit-x-${AWS::Region}
      DashboardBody: !Sub |-
        {"widgets":[
        {"type":"alarm","x":0,"y":0,"width":24,"height":6,"properties":{"title":"Alarms","alarms":["arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-a_1-discarded","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-a__b-discarded","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-errors","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-gap-risk","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-lag","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-a_1-polling","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-a__b-polling","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-rows-too-large","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-projector-throttles","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-views-broken","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-stream-a_1-write-throttles","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-at-the-limit-x-stream-a__b-write-throttles"],"sortBy":"stateUpdatedTimestamp"}},
        {"type":"metric","x":0,"y":6,"width":12,"height":6,"properties":{"title":"Projector iterator age (ms)","region":"${AWS::Region}","stat":"Maximum","period":300,"metrics":[["AWS/Lambda","IteratorAge","FunctionName","${Prefix}analytics-at-the-limit-x-projector"]]}},
        {"type":"metric","x":12,"y":6,"width":12,"height":6,"properties":{"title":"Projector invocations, errors and throttles","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["AWS/Lambda","Invocations","FunctionName","${Prefix}analytics-at-the-limit-x-projector"],["AWS/Lambda","Errors","FunctionName","${Prefix}analytics-at-the-limit-x-projector"],["AWS/Lambda","Throttles","FunctionName","${Prefix}analytics-at-the-limit-x-projector"]]}},
        {"type":"metric","x":0,"y":12,"width":12,"height":6,"properties":{"title":"Consumed write capacity units","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"ConsumedWriteCapacityUnits\" TableName=${Prefix}analytics-at-the-limit-x', 'Sum', 300)"}]]}},
        {"type":"metric","x":12,"y":12,"width":12,"height":6,"properties":{"title":"Throttled reads and writes","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"ReadThrottleEvents\" TableName=${Prefix}analytics-at-the-limit-x', 'Sum', 300)"}],[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"WriteThrottleEvents\" TableName=${Prefix}analytics-at-the-limit-x', 'Sum', 300)"}]]}},
        {"type":"metric","x":0,"y":18,"width":12,"height":6,"properties":{"title":"Replication latency to the other regions (ms)","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,ReceivingRegion,TableName} MetricName=\"ReplicationLatency\" TableName=${Prefix}analytics-at-the-limit-x', 'Maximum', 300)"}]]}},
        {"type":"metric","x":12,"y":18,"width":12,"height":6,"properties":{"title":"DynamoDB system errors","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,Operation,TableName} MetricName=\"SystemErrors\" TableName=${Prefix}analytics-at-the-limit-x', 'Sum', 300)"}]]}},
        {"type":"metric","x":0,"y":24,"width":12,"height":6,"properties":{"title":"Opened breakers, too-large rows and divergent duplicates","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["Dynaflux","BreakerOpened","Store","${Prefix}analytics-at-the-limit-x"],["Dynaflux","RowTooLarge","Store","${Prefix}analytics-at-the-limit-x"],["Dynaflux","DivergentDuplicates","Store","${Prefix}analytics-at-the-limit-x"]]}}
        ]}
