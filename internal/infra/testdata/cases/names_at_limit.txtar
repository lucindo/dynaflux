      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: view
      - Key: dynaflux:store
        Value: analytics-at-the-limit-x
  AlarmThrottlesProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-at-the-limit-x-projector-throttles
      AlarmDescription: "warning: Lambda has throttled the projector for 15 minutes. Raise the account's concurrent executions quota."
      Namespace: AWS/Lambda
      MetricName: Throttles
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics-at-the-limit-x
  AlarmViewsBroken:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-at-the-limit-x-views-broken
      AlarmDescription: "critical: a view stopped at an event it can't apply, and the other views go on. The projector's log names the view and the event."
      Namespace: Dynaflux
      MetricName: BreakerOpened
      Dimensions:
      - Name: Store
        Value: !Sub ${Prefix}analytics-at-the-limit-x
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: view
      - Key: dynaflux:store
        Value: analytics-at-the-limit-x
  AlarmWriteThrottlesStreamA1X1426674c:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-at-the-limit-x-stream-a_1-write-throttles
      AlarmDescription: "warning: DynamoDB has throttled writes to the table of stream a_1 for 15 minutes, so writers retry or fail. Check its capacity."
      Namespace: AWS/DynamoDB
      MetricName: WriteThrottleEvents
      Dimensions:
      - Name: TableName
        Value: !Sub ${Prefix}analytics-at-the-limit-x-stream-a_1
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: stream
      - Key: dynaflux:name
        Value: a_1
      - Key: dynaflux:store
        Value: analytics-at-the-limit-x
  AlarmWriteThrottlesStreamABX63e5c1c4:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-at-the-limit-x-stream-a__b-write-throttles
      AlarmDescription: "warning: DynamoDB has throttled writes to the table of stream a__b for 15 minutes, so writers retry or fail. Check its capacity."
      Namespace: AWS/DynamoDB
      MetricName: WriteThrottleEvents
      Dimensions:
      - Name: TableName
        Value: !Sub ${Prefix}analytics-at-the-limit-x-stream-a__b
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
