# Code generated by dynaflux v0.0.0-test. DO NOT EDIT.
AWSTemplateFormatVersion: "2010-09-09"
Transform: AWS::Serverless-2016-10-31
Description: "Dynaflux store analytics: the regional resources. Deploy in every region of the store, after global.yaml."
Parameters:
