      Tags:
      - Key: dynaflux:kind
        Value: backfill
      - Key: dynaflux:store
        Value: analytics
  RoleProjector:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
        - Effect: Allow
          Principal:
            Service: lambda.amazonaws.com
          Action: sts:AssumeRole
      Policies:
      - PolicyName: dynaflux
        PolicyDocument:
          Version: "2012-10-17"
          Statement:
          - Sid: Logs
            Effect: Allow
