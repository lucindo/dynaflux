  Backfill:
    Type: AWS::Serverless::Function
    Metadata:
      BuildMethod: go1.x
    Properties:
      FunctionName: !Sub ${Prefix}analytics-backfill
      CodeUri: ../../cmd/dynaflux-runtime
      Runtime: provided.al2023
      Handler: bootstrap
      Architectures:
      - arm64
      MemorySize: 3008
      Timeout: 900
      Role: !GetAtt RoleBackfill.Arn
      LoggingConfig:
        LogGroup: !Ref LogsBackfill
        LogFormat: JSON
      Environment:
        Variables:
          DYNAFLUX_MODE: backfill
          DYNAFLUX_PREFIX: !Ref Prefix
          DYNAFLUX_STORE: analytics
      Tags:
        dynaflux:kind: backfill
        dynaflux:store: analytics
  Projector:
    Type: AWS::Serverless::Function
    Metadata:
      BuildMethod: go1.x
    DependsOn:
    - ArchiveMode
    Properties:
      FunctionName: !Sub ${Prefix}analytics-projector
      CodeUri: ../../cmd/dynaflux-runtime
      Runtime: provided.al2023
      Handler: bootstrap
      Architectures:
      - arm64
      MemorySize: 1024
      Timeout: 60
      Role: !GetAtt RoleProjector.Arn
      LoggingConfig:
        LogGroup: !Ref LogsProjector
        LogFormat: JSON
      Environment:
        Variables:
          DYNAFLUX_MODE: projector
          DYNAFLUX_PREFIX: !Ref Prefix
          DYNAFLUX_STORE: analytics
