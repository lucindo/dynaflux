      Tags:
      - Key: dynaflux:kind
        Value: meta
      - Key: dynaflux:store
        Value: analytics
  Bucket:
    Type: AWS::S3::Bucket
    DeletionPolicy: RetainExceptOnCreate
    UpdateReplacePolicy: Retain
    Properties:
      BucketName: !Sub ${Prefix}analytics-${AWS::AccountId}-${AWS::Region}-an
      BucketNamespace: account-regional
      BucketEncryption:
