  LogsBackfill:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub /aws/lambda/${Prefix}analytics-backfill
      RetentionInDays: 30
      Tags:
      - Key: dynaflux:kind
        Value: backfill
      - Key: dynaflux:store
        Value: analytics
