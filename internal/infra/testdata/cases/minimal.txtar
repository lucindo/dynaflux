      KeySchema:
      - AttributeName: pk
        KeyType: HASH
      - AttributeName: sk
        KeyType: RANGE
      BillingMode: PAY_PER_REQUEST
      TimeToLiveSpecification:
        AttributeName: _ttl
        Enabled: true
      DeletionProtectionEnabled: false
      PointInTimeRecoverySpecification:
