        dynaflux:store: analytics
  Setup:
    Type: AWS::Serverless::Function
    Metadata:
      BuildMethod: go1.x
    Properties:
      FunctionName: !Sub ${Prefix}analytics-setup
      CodeUri: ../../cmd/dynaflux-runtime
      Runtime: provided.al2023
      Handler: bootstrap
      Architectures:
      - arm64
      MemorySize: 1024
      Timeout: 900
      Role: !GetAtt RoleSetup.Arn
      LoggingConfig:
        LogGroup: !Ref LogsSetup
        LogFormat: JSON
      Environment:
        Variables:
          DYNAFLUX_MODE: setup
          DYNAFLUX_PREFIX: !Ref Prefix
          DYNAFLUX_STORE: analytics
      Tags:
        dynaflux:kind: setup
        dynaflux:store: analytics
  LookupPageViews:
    Type: Custom::DynafluxStreamArn
    Properties:
      ServiceToken: !GetAtt Setup.Arn
      ServiceTimeout: 300
      TableName: !Sub ${Prefix}analytics-stream-page_views
      LookupGeneration: !Ref LookupGeneration
  MappingPageViews:
    Type: AWS::Lambda::EventSourceMapping
    Properties:
      FunctionName: !Ref Projector
      EventSourceArn: !GetAtt LookupPageViews.StreamArn
      StartingPosition: TRIM_HORIZON
      BatchSize: 100
      MaximumBatchingWindowInSeconds: 1
      ParallelizationFactor: 1
      BisectBatchOnFunctionError: true
      FunctionResponseTypes:
      - ReportBatchItemFailures
      MaximumRetryAttempts: -1
      MaximumRecordAgeInSeconds: -1
      TumblingWindowInSeconds: 900
      DestinationConfig:
        OnFailure:
          Destination: !GetAtt Bucket.Arn
      MetricsConfig:
        Metrics:
        - EventCount
  BackfillStateMachine:
    Type: AWS::StepFunctions::StateMachine
    Properties:
      StateMachineName: !Sub ${Prefix}analytics-backfill
      StateMachineType: STANDARD
      RoleArn: !GetAtt RoleBackfillStateMachine.Arn
      LoggingConfiguration:
        Level: ERROR
        IncludeExecutionData: false
        Destinations:
        - CloudWatchLogsLogGroup:
            LogGroupArn: !GetAtt LogsBackfillStateMachine.Arn
      DefinitionSubstitutions:
        Function: !GetAtt Backfill.Arn
        LambdaInvoke: !Sub arn:${AWS::Partition}:states:::lambda:invoke
        StartExecution: !Sub arn:${AWS::Partition}:states:::states:startExecution
      Definition:
        Comment: "Dynaflux backfill: runs a job's steps until it needs no more, waiting as each step asks, and continues in a new execution after 1000 steps."
        QueryLanguage: JSONata
        StartAt: Step
        States:
          Step:
            Type: Task
            Resource: ${LambdaInvoke}
            Arguments:
              FunctionName: ${Function}
              Payload:
                job: "{% $states.input.job %}"
                attempt: "{% $states.input.attempt %}"
                execution: "{% $states.context.Execution.Id %}"
            Output: "{% $merge([$states.input, {'steps': $states.input.steps + 1, 'done': $states.result.Payload.done, 'wait': $states.result.Payload.wait_seconds}]) %}"
            Retry:
            - ErrorEquals:
              - Lambda.ServiceException
              - Lambda.AWSLambdaException
              - Lambda.SdkClientException
              - Lambda.TooManyRequestsException
              IntervalSeconds: 2
              MaxAttempts: 6
              BackoffRate: 2
              JitterStrategy: FULL
            - ErrorEquals:
              - States.ALL
              IntervalSeconds: 30
              MaxAttempts: 5
              BackoffRate: 2
              JitterStrategy: FULL
            Next: Route
          Route:
            Type: Choice
            Choices:
            - Condition: "{% $states.input.done %}"
              Next: Done
            - Condition: "{% $states.input.steps >= 1000 %}"
              Next: Continue
            - Condition: "{% $states.input.wait > 0 %}"
              Next: Wait
            Default: Step
          Wait:
            Type: Wait
            Seconds: "{% $states.input.wait %}"
            Next: Step
          Continue:
            Type: Task
            Resource: ${StartExecution}
            Arguments:
              StateMachineArn: "{% $states.context.StateMachine.Id %}"
              Name: "{% $states.input.name & '-a' & $states.input.attempt & '-c' & ($states.input.k + 1) %}"
              Input:
                job: "{% $states.input.job %}"
                attempt: "{% $states.input.attempt %}"
                name: "{% $states.input.name %}"
                k: "{% $states.input.k + 1 %}"
                steps: 0
            Retry:
            - ErrorEquals:
              - States.ALL
              IntervalSeconds: 2
              MaxAttempts: 6
              BackoffRate: 2
              JitterStrategy: FULL
            End: true
          Done:
            Type: Succeed
      Tags:
      - Key: dynaflux:kind
        Value: backfill
      - Key: dynaflux:store
        Value: analytics
  ArchiveMode:
    Type: Custom::DynafluxArchiveMode
    Properties:
      ServiceToken: !GetAtt Setup.Arn
      ServiceTimeout: 300
      MetaTable: !Ref Meta
      Streams:
        page_views: "off"
  Catalog:
    Type: Custom::DynafluxCatalog
    DependsOn:
    - Backfill
    - Projector
    - RoleBackfillPolicy1
    Properties:
      ServiceToken: !GetAtt Setup.Arn
      ServiceTimeout: 300
      MetaTable: !Ref Meta
      CatalogHash: 29b14d07e9418c400c98fbbd07aaeb363e0f9fdb0d6b7d9aedd041c7caa62352
      Generator: v0.0.0-test
  AlarmDiscardedMappingPageViews:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-page_views-discarded
      AlarmDescription: "critical: the event source mapping of stream page_views sent records to its on-failure destination, under aws/lambda/ in the store's bucket, so the views miss them. Records that the stream trims after 24 hours aren't counted here: the projector's gap-risk alarm warns before that."
      Metrics:
      - Id: total
        Expression: m1 + m2
        ReturnData: true
      - Id: m1
        ReturnData: false
        MetricStat:
          Metric:
            Namespace: AWS/Lambda
            MetricName: OnFailureDestinationDeliveredEventCount
            Dimensions:
            - Name: EventSourceMappingUUID
              Value: !Ref MappingPageViews
          Period: 300
          Stat: Sum
      - Id: m2
        ReturnData: false
        MetricStat:
          Metric:
            Namespace: AWS/Lambda
            MetricName: DroppedEventCount
            Dimensions:
            - Name: EventSourceMappingUUID
              Value: !Ref MappingPageViews
          Period: 300
          Stat: Sum
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  AlarmErrorsProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-errors
      AlarmDescription: "warning: the projector has failed for 15 minutes, and the shards it reads wait. A deploy that changes the archive schema causes brief failures; otherwise read the projector's log group."
      Namespace: AWS/Lambda
      MetricName: Errors
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmFailedBackfillStateMachine:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-backfill-failed
      AlarmDescription: "critical: a backfill execution failed after its retries, so its job stopped. The backfill function's log group says why; dynaflux backfill resumes the job from its last chunk."
      Namespace: AWS/States
      MetricName: ExecutionsFailed
      Dimensions:
      - Name: StateMachineArn
        Value: !GetAtt BackfillStateMachine.Arn
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: backfill
      - Key: dynaflux:store
        Value: analytics
  AlarmGapRiskProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-gap-risk
      AlarmDescription: "critical: the projector is more than 6 hours behind. The stream trims records after 24 hours, and a record trimmed before the projector applies it leaves a hole in the views. Fix the projector's errors or throttles now."
      Namespace: AWS/Lambda
      MetricName: IteratorAge
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Maximum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 21600000
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmLagProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-lag
      AlarmDescription: "warning: the projector is more than 15 minutes behind, so the views are stale. The store's dashboard shows the projector's errors and throttles and the tables' throttles."
      Namespace: AWS/Lambda
      MetricName: IteratorAge
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Maximum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 900000
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmPollingMappingPageViews:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-page_views-polling
      AlarmDescription: "critical: the event source mapping of stream page_views hasn't polled for 15 minutes: it is disabled, or the projector can't read the stream. Check the mapping's state and the projector's role."
      Namespace: AWS/Lambda
      MetricName: PolledEventCount
      Dimensions:
      - Name: EventSourceMappingUUID
        Value: !Ref MappingPageViews
      Statistic: SampleCount
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: LessThanThreshold
      TreatMissingData: breaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  AlarmRowsTooLarge:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-rows-too-large
      AlarmDescription: "critical: a view row is over DynamoDB's 400 KB item limit, so the projector can't write it and its shard waits. The projector's log names the view and the row."
      Namespace: Dynaflux
      MetricName: RowTooLarge
      Dimensions:
      - Name: Store
        Value: !Sub ${Prefix}analytics
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: view
      - Key: dynaflux:store
        Value: analytics
  AlarmThrottlesProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-throttles
      AlarmDescription: "warning: Lambda has throttled the projector for 15 minutes. Raise the account's concurrent executions quota."
      Namespace: AWS/Lambda
      MetricName: Throttles
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmViewsBroken:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-views-broken
      AlarmDescription: "critical: a view stopped at an event it can't apply, and the other views go on. The projector's log names the view and the event."
      Namespace: Dynaflux
      MetricName: BreakerOpened
      Dimensions:
      - Name: Store
        Value: !Sub ${Prefix}analytics
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: view
      - Key: dynaflux:store
        Value: analytics
  AlarmWriteThrottlesStreamPageViews:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-stream-page_views-write-throttles
      AlarmDescription: "warning: DynamoDB has throttled writes to the table of stream page_views for 15 minutes, so writers retry or fail. Check its capacity."
      Namespace: AWS/DynamoDB
      MetricName: WriteThrottleEvents
      Dimensions:
      - Name: TableName
        Value: !Sub ${Prefix}analytics-stream-page_views
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: stream
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  Dashboard:
    Type: AWS::CloudWatch::Dashboard
    Properties:
      DashboardName: !Sub ${Prefix}analytics-${AWS::Region}
      DashboardBody: !Sub |-
        {"widgets":[
        {"type":"alarm","x":0,"y":0,"width":24,"height":6,"properties":{"title":"Alarms","alarms":["arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-page_views-discarded","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-errors","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-backfill-failed","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-gap-risk","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-lag","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-page_views-polling","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-rows-too-large","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-throttles","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-views-broken","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-stream-page_views-write-throttles"],"sortBy":"stateUpdatedTimestamp"}},
        {"type":"metric","x":0,"y":6,"width":12,"height":6,"properties":{"title":"Projector iterator age (ms)","region":"${AWS::Region}","stat":"Maximum","period":300,"metrics":[["AWS/Lambda","IteratorAge","FunctionName","${Prefix}analytics-projector"]]}},
        {"type":"metric","x":12,"y":6,"width":12,"height":6,"properties":{"title":"Projector invocations, errors and throttles","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["AWS/Lambda","Invocations","FunctionName","${Prefix}analytics-projector"],["AWS/Lambda","Errors","FunctionName","${Prefix}analytics-projector"],["AWS/Lambda","Throttles","FunctionName","${Prefix}analytics-projector"]]}},
        {"type":"metric","x":0,"y":12,"width":12,"height":6,"properties":{"title":"Consumed write capacity units","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"ConsumedWriteCapacityUnits\" TableName=${Prefix}analytics', 'Sum', 300)"}]]}},
        {"type":"metric","x":12,"y":12,"width":12,"height":6,"properties":{"title":"Throttled reads and writes","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"ReadThrottleEvents\" TableName=${Prefix}analytics', 'Sum', 300)"}],[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"WriteThrottleEvents\" TableName=${Prefix}analytics', 'Sum', 300)"}]]}},
        {"type":"metric","x":0,"y":18,"width":12,"height":6,"properties":{"title":"Backfill executions","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["AWS/States","ExecutionsStarted","StateMachineArn","arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:${Prefix}analytics-backfill"],["AWS/States","ExecutionsSucceeded","StateMachineArn","arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:${Prefix}analytics-backfill"],["AWS/States","ExecutionsFailed","StateMachineArn","arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:${Prefix}analytics-backfill"]]}},
        {"type":"metric","x":12,"y":18,"width":12,"height":6,"properties":{"title":"DynamoDB system errors","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,Operation,TableName} MetricName=\"SystemErrors\" TableName=${Prefix}analytics', 'Sum', 300)"}]]}},
        {"type":"metric","x":0,"y":24,"width":12,"height":6,"properties":{"title":"Opened breakers, too-large rows, divergent duplicates and values left out","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["Dynaflux","BreakerOpened","Store","${Prefix}analytics"],["Dynaflux","RowTooLarge","Store","${Prefix}analytics"],["Dynaflux","DivergentDuplicates","Store","${Prefix}analytics"],["Dynaflux","LeftOut","Store","${Prefix}analytics"]]}}
        ]}
