    Description: "Prefix of every resource name. Fixed for the life of the stack: a new prefix means new stacks."
  LookupGeneration:
    Type: String
    Default: "1"
    Description: Change it, to 2 for example, to look up the stream ARNs again after a stream table or replica was re-created.
  AlarmTopicArn:
    Type: String
    Default: ""
    Description: "ARN of the SNS topic, in the stack's region, that the alarms notify. Empty: the alarms notify no one."
Conditions:
  HasAlarmTopicArn: !Not
  - !Equals
    - !Ref AlarmTopicArn
    - ""
Resources:
  Meta:
    Type: AWS::DynamoDB::Table
    DeletionPolicy: Delete
    UpdateReplacePolicy: Delete
