One region, one stream, no view, archive off: global.yaml holds one Global Table with one
replica, and regional.yaml the meta table, the bucket, the projector and setup functions,
and the stream's lookup and mapping.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1]
archive:
  enabled: false
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);
-- want/global.stack-policy.json --
{
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "Update:*",
      "Principal": "*",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": "Update:Replace",
      "Principal": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ResourceType": [
            "AWS::DynamoDB::GlobalTable"
          ]
        }
      }
    }
  ]
}
-- want/global.yaml --
# Code generated by dynaflux v0.0.0-test. DO NOT EDIT.
AWSTemplateFormatVersion: "2010-09-09"
Description: "Dynaflux store analytics: the stream tables. Deploy once, in the store's home region."
Parameters:
  Prefix:
    Type: String
    Default: ""
    AllowedPattern: ^(?!xn--|sthree-|amzn-s3-demo-)([a-z][a-z0-9-]*-)?$
    MaxLength: 28
    Description: "Prefix of every resource name. Fixed for the life of the stack: a new prefix means new stacks."
Resources:
  StreamPageViews:
    Type: AWS::DynamoDB::GlobalTable
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      TableName: !Sub ${Prefix}analytics-stream-page_views
      AttributeDefinitions:
      - AttributeName: pk
        AttributeType: S
      - AttributeName: sk
        AttributeType: S
      KeySchema:
      - AttributeName: pk
        KeyType: HASH
      - AttributeName: sk
        KeyType: RANGE
      BillingMode: PAY_PER_REQUEST
      MultiRegionConsistency: EVENTUAL
      StreamSpecification:
        StreamViewType: NEW_AND_OLD_IMAGES
      TimeToLiveSpecification:
        AttributeName: _ttl
        Enabled: true
      Replicas:
      - Region: us-east-1
        DeletionProtectionEnabled: true
        PointInTimeRecoverySpecification:
          PointInTimeRecoveryEnabled: true
        Tags:
        - Key: dynaflux:kind
          Value: stream
        - Key: dynaflux:name
          Value: page_views
        - Key: dynaflux:store
          Value: analytics
