AWSTemplateFormatVersion: "2010-09-09"
Transform: AWS::Serverless-2016-10-31
Description: "Dynaflux store analytics: the regional resources. Deploy in every region of the store, after global.yaml."
Parameters:
  Prefix:
    Type: String
    Default: ""
    AllowedPattern: ^(?!xn--|sthree-|amzn-s3-demo-)([a-z][a-z0-9-]*-)?$
    MaxLength: 28
    Description: "Prefix of every resource name. Fixed for the life of the stack: a new prefix means new stacks."
  LookupGeneration:
    Type: String
    Default: "1"
    Description: Change it, to 2 for example, to look up the stream ARNs again after a stream table or replica was re-created.
  AlarmTopicArn:
    Type: String
    Default: ""
    Description: "ARN of the SNS topic, in the stack's region, that the alarms notify. Empty: the alarms notify no one."
Mappings:
  RegionSets:
    eu-west-1:
      Archive: "false"
    us-east-1:
      Archive: "true"
    us-west-1:
      Archive: "false"
Conditions:
  HasAlarmTopicArn: !Not
  - !Equals
    - !Ref AlarmTopicArn
    - ""
  InArchive: !Equals
  - !FindInMap
    - RegionSets
    - !Ref AWS::Region
    - Archive
  - "true"
Resources:
  Meta:
    Type: AWS::DynamoDB::Table
    DeletionPolicy: Delete
    UpdateReplacePolicy: Delete
