              - !Sub
                - arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/${PrefixUnderscore}analytics
                - {PrefixUnderscore: !Join [_, !Split ["-", !Ref Prefix]]}
              - !Sub
                - arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/${PrefixUnderscore}analytics/*
