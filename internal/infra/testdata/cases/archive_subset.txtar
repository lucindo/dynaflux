        Value: setup
      - Key: dynaflux:store
        Value: analytics
  Projector:
    Type: AWS::Serverless::Function
    Metadata:
      BuildMethod: go1.x
    Properties:
      FunctionName: !Sub ${Prefix}analytics-projector
      CodeUri: ../../cmd/dynaflux-runtime
      Runtime: provided.al2023
      Handler: bootstrap
      Architectures:
      - arm64
      MemorySize: 1024
      Timeout: 60
      Role: !GetAtt RoleProjector.Arn
      LoggingConfig:
        LogGroup: !Ref LogsProjector
        LogFormat: JSON
      Environment:
        Variables:
          DYNAFLUX_ARCHIVE_SCHEMA: !If
          - InArchive
          - !GetAtt ArchiveSchema.Fingerprint
          - !Ref AWS::NoValue
          DYNAFLUX_MODE: projector
          DYNAFLUX_PREFIX: !Ref Prefix
          DYNAFLUX_STORE: analytics
      Tags:
        dynaflux:kind: projector
        dynaflux:store: analytics
  Setup:
    Type: AWS::Serverless::Function
    Metadata:
      BuildMethod: go1.x
    Properties:
      FunctionName: !Sub ${Prefix}analytics-setup
      CodeUri: ../../cmd/dynaflux-runtime
      Runtime: provided.al2023
      Handler: bootstrap
      Architectures:
      - arm64
      MemorySize: 1024
      Timeout: 900
      Role: !GetAtt RoleSetup.Arn
      LoggingConfig:
        LogGroup: !Ref LogsSetup
        LogFormat: JSON
      Environment:
        Variables:
          DYNAFLUX_MODE: setup
          DYNAFLUX_PREFIX: !Ref Prefix
          DYNAFLUX_STORE: analytics
      Tags:
        dynaflux:kind: setup
        dynaflux:store: analytics
  LookupDebugEvents:
    Type: Custom::DynafluxStreamArn
    Properties:
      ServiceToken: !GetAtt Setup.Arn
      ServiceTimeout: 300
      TableName: !Sub ${Prefix}analytics-stream-debug_events
      LookupGeneration: !Ref LookupGeneration
  LookupPageViews:
    Type: Custom::DynafluxStreamArn
    Properties:
      ServiceToken: !GetAtt Setup.Arn
      ServiceTimeout: 300
      TableName: !Sub ${Prefix}analytics-stream-page_views
      LookupGeneration: !Ref LookupGeneration
  MappingDebugEvents:
    Type: AWS::Lambda::EventSourceMapping
    Properties:
      FunctionName: !Ref Projector
      EventSourceArn: !GetAtt LookupDebugEvents.StreamArn
      StartingPosition: TRIM_HORIZON
      BatchSize: 100
      MaximumBatchingWindowInSeconds: 1
      ParallelizationFactor: 1
      BisectBatchOnFunctionError: true
      FunctionResponseTypes:
      - ReportBatchItemFailures
      MaximumRetryAttempts: -1
      MaximumRecordAgeInSeconds: -1
      TumblingWindowInSeconds: 900
      DestinationConfig:
        OnFailure:
          Destination: !GetAtt Bucket.Arn
      MetricsConfig:
        Metrics:
        - EventCount
  MappingPageViews:
    Type: AWS::Lambda::EventSourceMapping
    Properties:
      FunctionName: !Ref Projector
      EventSourceArn: !GetAtt LookupPageViews.StreamArn
      StartingPosition: TRIM_HORIZON
      BatchSize: 100
      MaximumBatchingWindowInSeconds: 1
      ParallelizationFactor: 1
      BisectBatchOnFunctionError: true
      FunctionResponseTypes:
      - ReportBatchItemFailures
      MaximumRetryAttempts: -1
      MaximumRecordAgeInSeconds: -1
      TumblingWindowInSeconds: 900
      DestinationConfig:
        OnFailure:
          Destination: !GetAtt Bucket.Arn
      MetricsConfig:
        Metrics:
        - EventCount
  ArchiveWorkGroup:
    Type: AWS::Athena::WorkGroup
    Condition: InArchive
    Properties:
      Name: !Sub ${Prefix}analytics
      RecursiveDeleteOption: true
      WorkGroupConfiguration:
        EnforceWorkGroupConfiguration: true
        EngineVersion:
          SelectedEngineVersion: Athena engine version 3
        ManagedQueryResultsConfiguration:
          Enabled: true
      Tags:
      - Key: dynaflux:kind
        Value: archive
      - Key: dynaflux:store
        Value: analytics
  ArchiveSchema:
    Type: Custom::DynafluxArchiveSchema
    Condition: InArchive
    DependsOn:
    - LookupDebugEvents
    - LookupPageViews
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      ServiceToken: !GetAtt Setup.Arn
      ServiceTimeout: 900
      Database: !Sub
      - ${PrefixUnderscore}analytics
      - {PrefixUnderscore: !Join [_, !Split ["-", !Ref Prefix]]}
      DatabaseLocation: !Sub
      - s3://${Bucket}/warehouse/${PrefixUnderscore}analytics/
      - {PrefixUnderscore: !Join [_, !Split ["-", !Ref Prefix]]}
      WorkGroup: !Ref ArchiveWorkGroup
      OptimizerRoleArn: !GetAtt RoleArchiveOptimizer.Arn
      Optimizers:
        Compaction: binpack
        SnapshotRetentionDays: 5
        SnapshotsToKeep: 1
      Fingerprint: sha256:32858a980ca7477a641cce2540326c5c875c96822e6032dc2491e63438d0db1c
      Tables:
      - Name: page_views
        Location: !Sub
        - s3://${Bucket}/warehouse/${PrefixUnderscore}analytics/page_views/iceberg/
        - {PrefixUnderscore: !Join [_, !Split ["-", !Ref Prefix]]}
        Columns:
        - Name: event_id
          Type: string
        - Name: event_time
          Type: timestamp
        - Name: ingest_time
          Type: timestamp
        - Name: origin_region
          Type: string
        - Name: user_id
          Type: string
        - Name: page
          Type: string
        - Name: _shard
          Type: string
        - Name: _seq
          Type: string
        - Name: _arrival
          Type: timestamp
  FirehosePageViews:
    Type: AWS::KinesisFirehose::DeliveryStream
    Condition: InArchive
    DependsOn:
    - ArchiveSchema
    Properties:
      DeliveryStreamName: !Sub ${Prefix}analytics-archive-page_views
      DeliveryStreamType: DirectPut
      IcebergDestinationConfiguration:
        AppendOnly: true
        CatalogConfiguration:
          CatalogArn: !Sub arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:catalog
        DestinationTableConfigurationList:
        - DestinationDatabaseName: !Sub
          - ${PrefixUnderscore}analytics
          - {PrefixUnderscore: !Join [_, !Split ["-", !Ref Prefix]]}
          DestinationTableName: page_views
        BufferingHints:
          IntervalInSeconds: 300
          SizeInMBs: 128
        RetryOptions:
          DurationInSeconds: 7200
        s3BackupMode: FailedDataOnly
        RoleARN: !GetAtt RoleArchive.Arn
        S3Configuration:
          BucketARN: !GetAtt Bucket.Arn
          RoleARN: !GetAtt RoleArchive.Arn
          ErrorOutputPrefix: errors/firehose/page_views/
        CloudWatchLoggingOptions:
          Enabled: true
          LogGroupName: !Ref LogsArchive
          LogStreamName: !Ref LogStreamPageViews
      Tags:
      - Key: dynaflux:kind
        Value: archive
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  AlarmDiscardedMappingDebugEvents:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-debug_events-discarded
      AlarmDescription: "critical: the event source mapping of stream debug_events sent records to its on-failure destination, under aws/lambda/ in the store's bucket, so the views miss them. Records that the stream trims after 24 hours aren't counted here: the projector's gap-risk alarm warns before that."
      Metrics:
      - Id: total
        Expression: m1 + m2
        ReturnData: true
      - Id: m1
        ReturnData: false
        MetricStat:
          Metric:
            Namespace: AWS/Lambda
            MetricName: OnFailureDestinationDeliveredEventCount
            Dimensions:
            - Name: EventSourceMappingUUID
              Value: !Ref MappingDebugEvents
          Period: 300
          Stat: Sum
      - Id: m2
        ReturnData: false
        MetricStat:
          Metric:
            Namespace: AWS/Lambda
            MetricName: DroppedEventCount
            Dimensions:
            - Name: EventSourceMappingUUID
              Value: !Ref MappingDebugEvents
          Period: 300
          Stat: Sum
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:name
        Value: debug_events
      - Key: dynaflux:store
        Value: analytics
  AlarmDiscardedMappingPageViews:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-page_views-discarded
      AlarmDescription: "critical: the event source mapping of stream page_views sent records to its on-failure destination, under aws/lambda/ in the store's bucket, so the views miss them. Records that the stream trims after 24 hours aren't counted here: the projector's gap-risk alarm warns before that."
      Metrics:
      - Id: total
        Expression: m1 + m2
        ReturnData: true
      - Id: m1
        ReturnData: false
        MetricStat:
          Metric:
            Namespace: AWS/Lambda
            MetricName: OnFailureDestinationDeliveredEventCount
            Dimensions:
            - Name: EventSourceMappingUUID
              Value: !Ref MappingPageViews
          Period: 300
          Stat: Sum
      - Id: m2
        ReturnData: false
        MetricStat:
          Metric:
            Namespace: AWS/Lambda
            MetricName: DroppedEventCount
            Dimensions:
            - Name: EventSourceMappingUUID
              Value: !Ref MappingPageViews
          Period: 300
          Stat: Sum
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  AlarmErrorsProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-errors
      AlarmDescription: "warning: the projector has failed for 15 minutes, and the shards it reads wait. A deploy that changes the archive schema causes brief failures; otherwise read the projector's log group."
      Namespace: AWS/Lambda
      MetricName: Errors
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmFailedRowsFirehosePageViews:
    Type: AWS::CloudWatch::Alarm
    Condition: InArchive
    Properties:
      AlarmName: !Sub ${Prefix}analytics-archive-page_views-failed-rows
      AlarmDescription: "critical: Firehose couldn't write rows of stream page_views to its archive table, so the archive misses them. They are under errors/firehose/page_views/ in the store's bucket."
      Namespace: AWS/Firehose
      MetricName: DeliveryToIceberg.FailedRowCount
      Dimensions:
      - Name: DeliveryStreamName
        Value: !Ref FirehosePageViews
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: archive
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  AlarmFreshnessFirehosePageViews:
    Type: AWS::CloudWatch::Alarm
    Condition: InArchive
    Properties:
      AlarmName: !Sub ${Prefix}analytics-archive-page_views-freshness
      AlarmDescription: "warning: Firehose has held records of stream page_views for more than 15 minutes without writing them to the archive. Read its log group."
      Namespace: AWS/Firehose
      MetricName: DeliveryToIceberg.DataFreshness
      Dimensions:
      - Name: DeliveryStreamName
        Value: !Ref FirehosePageViews
      Statistic: Maximum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 900
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: archive
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  AlarmGapRiskProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-gap-risk
      AlarmDescription: "critical: the projector is more than 6 hours behind. The stream trims records after 24 hours, and a record trimmed before the projector applies it leaves a hole in the views. Fix the projector's errors or throttles now."
      Namespace: AWS/Lambda
      MetricName: IteratorAge
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Maximum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 21600000
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmLagProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-lag
      AlarmDescription: "warning: the projector is more than 15 minutes behind, so the views are stale. The store's dashboard shows the projector's errors and throttles and the tables' throttles."
      Namespace: AWS/Lambda
      MetricName: IteratorAge
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Maximum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 900000
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmPollingMappingDebugEvents:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-debug_events-polling
      AlarmDescription: "critical: the event source mapping of stream debug_events hasn't polled for 15 minutes: it is disabled, or the projector can't read the stream. Check the mapping's state and the projector's role."
      Namespace: AWS/Lambda
      MetricName: PolledEventCount
      Dimensions:
      - Name: EventSourceMappingUUID
        Value: !Ref MappingDebugEvents
      Statistic: SampleCount
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: LessThanThreshold
      TreatMissingData: breaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:name
        Value: debug_events
      - Key: dynaflux:store
        Value: analytics
  AlarmPollingMappingPageViews:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-page_views-polling
      AlarmDescription: "critical: the event source mapping of stream page_views hasn't polled for 15 minutes: it is disabled, or the projector can't read the stream. Check the mapping's state and the projector's role."
      Namespace: AWS/Lambda
      MetricName: PolledEventCount
      Dimensions:
      - Name: EventSourceMappingUUID
        Value: !Ref MappingPageViews
      Statistic: SampleCount
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: LessThanThreshold
      TreatMissingData: breaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  AlarmRowsTooLarge:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-rows-too-large
      AlarmDescription: "critical: a view row is over DynamoDB's 400 KB item limit, so the projector can't write it and its shard waits. The projector's log names the view and the row."
      Namespace: Dynaflux
      MetricName: RowTooLarge
      Dimensions:
      - Name: Store
        Value: !Sub ${Prefix}analytics
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: view
      - Key: dynaflux:store
        Value: analytics
  AlarmThrottlesProjector:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-projector-throttles
      AlarmDescription: "warning: Lambda has throttled the projector for 15 minutes. Raise the account's concurrent executions quota."
      Namespace: AWS/Lambda
      MetricName: Throttles
      Dimensions:
      - Name: FunctionName
        Value: !Ref Projector
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  AlarmViewsBroken:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-views-broken
      AlarmDescription: "critical: a view stopped at an event it can't apply, and the other views go on. The projector's log names the view and the event."
      Namespace: Dynaflux
      MetricName: BreakerOpened
      Dimensions:
      - Name: Store
        Value: !Sub ${Prefix}analytics
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: view
      - Key: dynaflux:store
        Value: analytics
  AlarmWriteThrottlesStreamDebugEvents:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-stream-debug_events-write-throttles
      AlarmDescription: "warning: DynamoDB has throttled writes to the table of stream debug_events for 15 minutes, so writers retry or fail. Check its capacity."
      Namespace: AWS/DynamoDB
      MetricName: WriteThrottleEvents
      Dimensions:
      - Name: TableName
        Value: !Sub ${Prefix}analytics-stream-debug_events
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: stream
      - Key: dynaflux:name
        Value: debug_events
      - Key: dynaflux:store
        Value: analytics
  AlarmWriteThrottlesStreamPageViews:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub ${Prefix}analytics-stream-page_views-write-throttles
      AlarmDescription: "warning: DynamoDB has throttled writes to the table of stream page_views for 15 minutes, so writers retry or fail. Check its capacity."
      Namespace: AWS/DynamoDB
      MetricName: WriteThrottleEvents
      Dimensions:
      - Name: TableName
        Value: !Sub ${Prefix}analytics-stream-page_views
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 3
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      OKActions: !If
      - HasAlarmTopicArn
      - - !Ref AlarmTopicArn
      - !Ref AWS::NoValue
      Tags:
      - Key: dynaflux:kind
        Value: stream
      - Key: dynaflux:name
        Value: page_views
      - Key: dynaflux:store
        Value: analytics
  Dashboard:
    Type: AWS::CloudWatch::Dashboard
    Properties:
      DashboardName: !Sub ${Prefix}analytics-${AWS::Region}
      DashboardBody: !Sub |-
        {"widgets":[
        {"type":"alarm","x":0,"y":0,"width":24,"height":6,"properties":{"title":"Alarms","alarms":["arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-debug_events-discarded","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-page_views-discarded","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-errors","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-archive-page_views-failed-rows","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-archive-page_views-freshness","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-gap-risk","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-lag","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-debug_events-polling","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-page_views-polling","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-rows-too-large","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-projector-throttles","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-views-broken","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-stream-debug_events-write-throttles","arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${Prefix}analytics-stream-page_views-write-throttles"],"sortBy":"stateUpdatedTimestamp"}},
        {"type":"metric","x":0,"y":6,"width":12,"height":6,"properties":{"title":"Projector iterator age (ms)","region":"${AWS::Region}","stat":"Maximum","period":300,"metrics":[["AWS/Lambda","IteratorAge","FunctionName","${Prefix}analytics-projector"]]}},
        {"type":"metric","x":12,"y":6,"width":12,"height":6,"properties":{"title":"Projector invocations, errors and throttles","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["AWS/Lambda","Invocations","FunctionName","${Prefix}analytics-projector"],["AWS/Lambda","Errors","FunctionName","${Prefix}analytics-projector"],["AWS/Lambda","Throttles","FunctionName","${Prefix}analytics-projector"]]}},
        {"type":"metric","x":0,"y":12,"width":12,"height":6,"properties":{"title":"Archive records","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["AWS/Firehose","IncomingRecords","DeliveryStreamName","${Prefix}analytics-archive-page_views"],["AWS/Firehose","DeliveryToIceberg.SuccessfulRowCount","DeliveryStreamName","${Prefix}analytics-archive-page_views"],["AWS/Firehose","DeliveryToIceberg.FailedRowCount","DeliveryStreamName","${Prefix}analytics-archive-page_views"],["AWS/Firehose","ThrottledRecords","DeliveryStreamName","${Prefix}analytics-archive-page_views"]]}},
        {"type":"metric","x":12,"y":12,"width":12,"height":6,"properties":{"title":"Archive data freshness (s)","region":"${AWS::Region}","stat":"Maximum","period":300,"metrics":[["AWS/Firehose","DeliveryToIceberg.DataFreshness","DeliveryStreamName","${Prefix}analytics-archive-page_views"]]}},
        {"type":"metric","x":0,"y":18,"width":12,"height":6,"properties":{"title":"Consumed write capacity units","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"ConsumedWriteCapacityUnits\" TableName=${Prefix}analytics', 'Sum', 300)"}]]}},
        {"type":"metric","x":12,"y":18,"width":12,"height":6,"properties":{"title":"Throttled reads and writes","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"ReadThrottleEvents\" TableName=${Prefix}analytics', 'Sum', 300)"}],[{"expression":"SEARCH('{AWS/DynamoDB,TableName} MetricName=\"WriteThrottleEvents\" TableName=${Prefix}analytics', 'Sum', 300)"}]]}},
        {"type":"metric","x":0,"y":24,"width":12,"height":6,"properties":{"title":"Replication latency to the other regions (ms)","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,ReceivingRegion,TableName} MetricName=\"ReplicationLatency\" TableName=${Prefix}analytics', 'Maximum', 300)"}]]}},
        {"type":"metric","x":12,"y":24,"width":12,"height":6,"properties":{"title":"DynamoDB system errors","region":"${AWS::Region}","period":300,"metrics":[[{"expression":"SEARCH('{AWS/DynamoDB,Operation,TableName} MetricName=\"SystemErrors\" TableName=${Prefix}analytics', 'Sum', 300)"}]]}},
        {"type":"metric","x":0,"y":30,"width":12,"height":6,"properties":{"title":"Opened breakers, too-large rows and divergent duplicates","region":"${AWS::Region}","stat":"Sum","period":300,"metrics":[["Dynaflux","BreakerOpened","Store","${Prefix}analytics"],["Dynaflux","RowTooLarge","Store","${Prefix}analytics"],["Dynaflux","DivergentDuplicates","Store","${Prefix}analytics"]]}}
        ]}
