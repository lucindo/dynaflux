Copyright 2026 The Dynaflux Authors
SPDX-License-Identifier: Apache-2.0

Three regions, of which only us-east-1 archives: AWS Glue has no table optimizers in
us-west-1. The RegionSets mapping and the InArchive condition keep the archive resources,
the archive grants and DYNAFLUX_ARCHIVE_SCHEMA out of the other regions, and nothing that
exists everywhere depends on an archive resource. debug_events isn't archived, so it has
no Firehose stream or table, while its lookup still comes before the archive schema.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1, us-west-1, eu-west-1]
archive:
  regions: [us-east-1]
  streams:
    debug_events: {enabled: false}
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);

CREATE STREAM debug_events (user_id String, message String)
PRIMARY KEY (user_id)
LOG RETENTION FOREVER;
-- want/global.stack-policy.json --
{
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "Update:*",
      "Principal": "*",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": "Update:Replace",
      "Principal": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ResourceType": [
            "AWS::DynamoDB::GlobalTable"
          ]
        }
      }
    }
  ]
}
-- want/global.yaml --
