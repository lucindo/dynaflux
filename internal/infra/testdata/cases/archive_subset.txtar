      - Key: dynaflux:kind
        Value: projector
      - Key: dynaflux:store
        Value: analytics
  RoleSetup:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
        - Effect: Allow
