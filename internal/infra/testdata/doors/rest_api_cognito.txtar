A REST API with a Cognito authorizer, behind a custom domain: the method asks for one of
the scopes, and the authorizer matches an ID token's aud against the app clients. Both
together warn (DF6616); the case pins how each renders. The health check calls /api/health,
under the stage.
-- dynaflux.yaml --
store: analytics
prefix: prod-
regions: [us-east-1]
archive:
  enabled: false
http:
  frontend: rest_api
  auth: cognito
  cognito:
    user_pool_arn: arn:aws:cognito-idp:us-east-1:123456789012:userpool/us-east-1_abc
    scopes: [dynaflux/query]
    app_clients: [client.a, client-b]
  domain:
    name: flux.example.com
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_counts
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;
-- dynaflux/queries.sql --
-- name: PageViews :one
-- expose: http
SELECT views FROM page_counts WHERE page = {page:String};
-- want/query.yaml --
