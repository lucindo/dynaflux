    Properties:
      AlarmName: !Sub ${Prefix}analytics-query-certificate
      AlarmDescription: "warning: the custom domain's certificate expires in less than 45 days, so ACM, which renews it from 60 days ahead, couldn't. Check that its DNS validation record is still in the hosted zone."
      Namespace: AWS/CertificateManager
      MetricName: DaysToExpiry
      Dimensions:
      - Name: CertificateArn
        Value: !Ref Certificate
      Statistic: Minimum
      Period: 86400
      EvaluationPeriods: 1
      Threshold: 45
      ComparisonOperator: LessThanThreshold
      TreatMissingData: notBreaching
      AlarmActions: !If
