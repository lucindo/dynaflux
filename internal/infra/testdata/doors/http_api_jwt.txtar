    Properties:
      ScheduleExpression: rate(1 minute)
      State: ENABLED
      Targets:
      - Arn: !GetAtt Query.Arn
        Id: Function
      Tags:
      - Key: dynaflux:kind
        Value: query
      - Key: dynaflux:store
        Value: analytics
  HealthCheck:
    Type: AWS::Route53::HealthCheck
    Properties:
      HealthCheckConfig:
        Type: CLOUDWATCH_METRIC
        AlarmIdentifier:
