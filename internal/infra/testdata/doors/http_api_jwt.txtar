An HTTP API with a JWT authorizer whose route asks for scopes, behind a custom domain: a
certificate with its expiry alarm, the domain mapped to the stage, and a latency record that
follows an HTTPS health check, with SNI, of the region's own /health.
-- dynaflux.yaml --
store: analytics
prefix: prod-
regions: [us-east-1]
archive:
  enabled: false
http:
  frontend: http_api
  auth: jwt
  jwt:
    issuer: https://cognito-idp.us-east-1.amazonaws.com/us-east-1_abc
    audience: [client-a, client-b]
    scopes: [dynaflux/query]
  domain:
    name: flux.example.com
-- dynaflux/streams.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);
-- dynaflux/views.sql --
CREATE MATERIALIZED VIEW page_counts
ORDER BY (page)
AS SELECT page, count() AS views
FROM page_views
GROUP BY page;
-- dynaflux/queries.sql --
-- name: PageViews :one
-- expose: http
SELECT views FROM page_counts WHERE page = {page:String};
-- want/query.yaml --
# Code generated by dynaflux v0.0.0-test. DO NOT EDIT.
AWSTemplateFormatVersion: "2010-09-09"
Transform: AWS::Serverless-2016-10-31
Description: "Dynaflux store analytics: the query function and its front door. Deploy in every region of the store with the application, after regional.yaml and the backfill."
Parameters:
  Prefix:
    Type: String
    Default: prod-
    AllowedPattern: ^(?!xn--|sthree-|amzn-s3-demo-)([a-z][a-z0-9-]*-)?$
    MaxLength: 28
    Description: "Prefix of every resource name. Fixed for the life of the stack: a new prefix means new stacks."
  AlarmTopicArn:
    Type: String
    Default: ""
    Description: "ARN of the SNS topic, in the stack's region, that the alarms notify. Empty: the alarms notify no one."
  DomainName:
    Type: String
    Default: flux.example.com
    Description: The custom domain of the API, in the hosted zone HostedZoneId. Each environment needs its own.
  HostedZoneId:
    Type: AWS::Route53::HostedZone::Id
    Description: The ID of the public Route 53 hosted zone that holds DomainName.
Conditions:
  HasAlarmTopicArn: !Not
  - !Equals
    - !Ref AlarmTopicArn
    - ""
Resources:
  LogsApi:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub /aws/vendedlogs/apigateway/${Prefix}analytics-query
      RetentionInDays: 30
      Tags:
