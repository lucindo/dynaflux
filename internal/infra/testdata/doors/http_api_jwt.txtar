        Value: query
      - Key: dynaflux:store
        Value: analytics
  LogsQuery:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub /aws/lambda/${Prefix}analytics-query
      RetentionInDays: 30
      Tags:
      - Key: dynaflux:kind
        Value: query
      - Key: dynaflux:store
        Value: analytics
  RoleQuery:
    Type: AWS::IAM::Role
