Generated names: go.package, initialisms, -- go:type, a plural in -ies, a PRIMARY KEY of
two columns, LOG RETENTION FOREVER (no log-window sentence), and a query without
parameters.
-- dynaflux.yaml --
store: analytics
regions: [us-east-1]
go:
  package: client
-- dynaflux/streams.sql --
-- go:type Hit
CREATE STREAM api_url_visits (
    visitor_uuid UUID,
    page_url     String,
    http_status  UInt16
)
PRIMARY KEY (visitor_uuid, page_url)
LOG RETENTION FOREVER;

CREATE STREAM categories (category_id String, parent_id Nullable(String))
PRIMARY KEY (category_id);

-- name: RootCategories :many
SELECT parent_id, event_time
FROM categories
WHERE category_id = 'root'
ORDER BY event_time;
