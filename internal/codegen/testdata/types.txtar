Every column type, plain, Nullable and Array, with the Go type of ADR 0005; DEFAULT
values of several types in the field comments; a query with a parameter of each kind,
an Array one after IN, and a LIMIT parameter; and a row with DateTime, Decimal and
Nullable results.
-- dynaflux/streams.sql --
CREATE STREAM readings (
    s      String,
    u8     UInt8,
    u16    UInt16,
    u32    UInt32,
    u64    UInt64,
    i8     Int8,
    i16    Int16,
    i32    Int32,
    i64    Int64,
    f      Float64,
    d      Decimal(10, 2),
    b      Bool,
    id     UUID,
    day    Date,
    ms     DateTime64(3),
    us     DateTime64(6),
    note   Nullable(String),
    seen   Nullable(DateTime64(3)),
    tags   Array(String),
    vals   Array(Int32),
    label  String DEFAULT 'it''s a \\ path',
    level  UInt8 DEFAULT 3,
    price  Decimal(10, 2) DEFAULT 9.5,
    since  Date DEFAULT '2024-01-31',
    active Bool DEFAULT true,
    codes  Array(UInt16) DEFAULT [1, 2]
)
PRIMARY KEY (s);

CREATE MATERIALIZED VIEW readings_hourly
ORDER BY (s, hour)
PRIMARY KEY (s)
AS SELECT
    s,
    toStartOfHour(event_time) AS hour,
    count()                   AS n,
    sum(d)                    AS total_d,
    max(note)                 AS last_note
FROM readings
GROUP BY s, hour;

-- name: Readings :many
SELECT s, u8, f, d, id, day, us, note, tags
FROM readings
WHERE s IN {keys:Array(String)}
  AND event_time >= {since:DateTime64(6)}
  AND u8 = {u8:UInt8}
  AND i64 > {i64:Int64}
  AND f < {f:Float64}
  AND d > {d:Decimal(10, 2)}
  AND b = {b:Bool}
  AND id = {id:UUID}
  AND day >= {day:Date}
  AND ms < {ms:DateTime64(3)}
ORDER BY event_time
LIMIT {n:UInt32};

-- name: Hourly :many
SELECT hour, n, total_d, last_note
FROM readings_hourly
WHERE s = {s:String}
ORDER BY hour;
