// Code generated by dynaflux v0.0.0-test. DO NOT EDIT.

package flux

import (
	"context"
	"iter"
	"time"

	"github.com/lucindo/dynaflux"
	"github.com/lucindo/dynaflux/fluxgen"
)

// Reading is an event of stream readings.
type Reading struct {
	S      string           // s String
	U8     uint8            // u8 UInt8
	U16    uint16           // u16 UInt16
	U32    uint32           // u32 UInt32
	U64    uint64           // u64 UInt64
	I8     int8             // i8 Int8
	I16    int16            // i16 Int16
	I32    int32            // i32 Int32
	I64    int64            // i64 Int64
	F      float64          // f Float64
	D      dynaflux.Decimal // d Decimal(10, 2)
	B      bool             // b Bool
	ID     dynaflux.UUID    // id UUID
	Day    time.Time        // day Date
	MS     time.Time        // ms DateTime64(3)
	Us     time.Time        // us DateTime64(6)
	Note   *string          // note Nullable(String)
	Seen   *time.Time       // seen Nullable(DateTime64(3))
	Tags   []string         // tags Array(String)
	Vals   []int32          // vals Array(Int32)
	Label  string           // label String DEFAULT 'it\'s a \\ path': only for events stored before the column existed; Append stores the value given
	Level  uint8            // level UInt8 DEFAULT 3: only for events stored before the column existed; Append stores the value given
	Price  dynaflux.Decimal // price Decimal(10, 2) DEFAULT 9.50: only for events stored before the column existed; Append stores the value given
	Since  time.Time        // since Date DEFAULT '2024-01-31': only for events stored before the column existed; Append stores the value given
	Active bool             // active Bool DEFAULT true: only for events stored before the column existed; Append stores the value given
	Codes  []uint16         // codes Array(UInt16) DEFAULT [1, 2]: only for events stored before the column existed; Append stores the value given

	// EventTime is when the fact happened. Left zero, Append uses the writer's clock.
	EventTime time.Time
	// EventID, IngestTime and OriginRegion are set by Dynaflux when it stores the event.
	// Read returns them, and Append ignores them.
	EventID      string
	IngestTime   time.Time
	OriginRegion string
}

// ReadingsKey selects the events of stream readings with one PRIMARY KEY value.
type ReadingsKey struct {
	S string // s String
}

// AppendReading appends ev to stream readings.
func (c *Client) AppendReading(ctx context.Context, ev Reading, opts ...dynaflux.AppendOption) (dynaflux.Token, error) {
	return fluxgen.AppendEvent(ctx, c.store, Catalog, "readings", ev.fields(), opts...)
}

// AppendReadingBatch appends evs to stream readings, each event as its own write.
// The Token covers every event it stored. When an event fails, the error is a
// *dynaflux.BatchError whose Errs line up with evs, nil for each stored event.
func (c *Client) AppendReadingBatch(ctx context.Context, evs []Reading, opts ...dynaflux.AppendOption) (dynaflux.Token, error) {
	return fluxgen.AppendEvents(ctx, c.store, Catalog, "readings", evs, (*Reading).fields, opts...)
}

// ReadReadings returns the events of stream readings with the PRIMARY KEY value
// key, in (event_time, event_id) order.
// It reads the stream's log window (2 DAY): older events are only in the archive.
func (c *Client) ReadReadings(ctx context.Context, key ReadingsKey, opts ...dynaflux.ReadOption) iter.Seq2[Reading, error] {
	return fluxgen.ReadEvents(ctx, c.store, Catalog, "readings", key.fields(), (*Reading).fields, opts...)
}

// ImportReadings appends evs to stream readings as AppendReadingBatch does, but
// without the ACCEPT window, to load past events.
// It isn't idempotent: a retry after a partial failure stores again the events that
// the first call stored, with new event IDs.
func (c *Client) ImportReadings(ctx context.Context, evs []Reading, opts ...dynaflux.AppendOption) error {
	return fluxgen.ImportEvents(ctx, c.store, Catalog, "readings", evs, (*Reading).fields, opts...)
}

// fields returns pointers to the event's fields in catalog order: the declared columns,
// then event_id, event_time, ingest_time and origin_region.
func (e *Reading) fields() []any {
	return []any{
		&e.S,
		&e.U8,
		&e.U16,
		&e.U32,
		&e.U64,
		&e.I8,
		&e.I16,
		&e.I32,
		&e.I64,
		&e.F,
		&e.D,
		&e.B,
		&e.ID,
		&e.Day,
		&e.MS,
		&e.Us,
		&e.Note,
		&e.Seen,
		&e.Tags,
		&e.Vals,
		&e.Label,
		&e.Level,
		&e.Price,
		&e.Since,
		&e.Active,
		&e.Codes,
		&e.EventID,
		&e.EventTime,
		&e.IngestTime,
		&e.OriginRegion,
	}
}

func (k *ReadingsKey) fields() []any {
	return []any{&k.S}
}
