-- want/catalog.go --
// Code generated by dynaflux v0.0.0-test. DO NOT EDIT.

package flux

import "github.com/lucindo/dynaflux/fluxgen"

// Catalog holds the compiled definitions of store analytics, which every Client uses.
var Catalog = fluxgen.LoadCatalog(catalogJSON)

const catalogJSON = `{"format":1,"catalog":{"store":"analytics","regions":["us-east-1","us-west-2"],"prune_window_seconds":960}}`
-- want/client.go --
// Code generated by dynaflux v0.0.0-test. DO NOT EDIT.

// Package flux is the typed client of store analytics, generated by dynaflux from
// its SQL definitions.
package flux

import "github.com/lucindo/dynaflux"

// This line fails to compile when the dynaflux module in go.mod can't run this code.
// Regenerate it with the version in go.mod: go tool dynaflux generate.
const _ = dynaflux.GeneratedCodeVersion1

// Client appends to the streams and runs the named queries of store analytics.
type Client struct {
	store *dynaflux.Store
}

// New returns a Client that uses store.
func New(store *dynaflux.Store) *Client {
	return &Client{store: store}
}
