A :one query that aggregates without GROUP BY returns one row, except when its LIMIT
parameter is 0: then it returns dynaflux.ErrNotFound (sql.md §10.8).
-- dynaflux/pages.sql --
CREATE STREAM page_views (user_id String, page String)
PRIMARY KEY (user_id);

CREATE MATERIALIZED VIEW page_daily
ORDER BY (page, day)
PRIMARY KEY (page)
AS SELECT page, toStartOfDay(event_time) AS day, count() AS views
FROM page_views
GROUP BY page, day;

-- name: Total :one
SELECT sum(views) AS total
FROM page_daily
WHERE page = {page:String}
LIMIT {n:UInt32};
