package flux

import (
	"context"

	"github.com/lucindo/dynaflux"
	"github.com/lucindo/dynaflux/fluxgen"
)

// TotalParams are the parameters of query Total.
type TotalParams struct {
	Page string // {page:String}
	N    uint32 // {n:UInt32} LIMIT: 0 returns no rows
}

// TotalRow is a row of query Total.
type TotalRow struct {
	Total uint64 // total UInt64
}

// Total runs query Total over view page_daily.
// It returns dynaflux.ErrNotFound when there is no row.
func (c *Client) Total(ctx context.Context, arg TotalParams, opts ...dynaflux.QueryOption) (TotalRow, error) {
	return fluxgen.QueryRow(ctx, c.store, Catalog, "Total", arg.fields(), (*TotalRow).fields, opts...)
}

func (p *TotalParams) fields() []any {
	return []any{&p.Page, &p.N}
}

func (r *TotalRow) fields() []any {
	return []any{&r.Total}
}
