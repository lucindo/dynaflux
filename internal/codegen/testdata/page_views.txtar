// PageView is an event of stream page_views.
type PageView struct {
	UserID     string   // user_id String
	Page       string   // page String
	Referrer   *string  // referrer Nullable(String)
	Tags       []string // tags Array(String)
	DurationMS uint32   // duration_ms UInt32
	Country    string   // country String DEFAULT '': only for events stored before the column existed; Append stores the value given

	// EventTime is when the fact happened. Left zero, Append uses the writer's clock.
	EventTime time.Time
	// EventID, IngestTime and OriginRegion are set by Dynaflux when it stores the event.
	// Read returns them, and Append ignores them.
	EventID      string
	IngestTime   time.Time
	OriginRegion string
}

// PageViewsKey selects the events of stream page_views with one PRIMARY KEY value.
type PageViewsKey struct {
	UserID string // user_id String
}

