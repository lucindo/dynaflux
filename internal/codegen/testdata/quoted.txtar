DEFAULT values with a backquote, a byte-order mark and a right-to-left override. The
catalog literal can't be a raw string, and the field comments escape the characters
that aren't printable.
-- dynaflux/streams.sql --
CREATE STREAM notes (
    id   String,
    tick String DEFAULT 'a`b',
    bom  String DEFAULT '\xef\xbb\xbfx',
    rtl  String DEFAULT '\xe2\x80\xaey'
)
PRIMARY KEY (id);
