The live table isn't an Iceberg table: the setup function never converts a table.
-- properties.json --
{
  "ServiceToken": "arn:aws:lambda:us-east-1:123456789012:function:prod-analytics-setup",
  "ServiceTimeout": "900",
  "Database": "prod_analytics",
  "WorkGroup": "prod-analytics",
  "DatabaseLocation": "s3://prod-analytics-123456789012-us-east-1-an/warehouse/prod_analytics/",
  "OptimizerRoleArn": "arn:aws:iam::123456789012:role/prod-analytics-regional-RoleArchiveOptimizer-1A2B3C4D5E6F",
  "Optimizers": {
    "Compaction": "binpack",
    "SnapshotRetentionDays": "5",
    "SnapshotsToKeep": "1"
  },
  "Fingerprint": "sha256:dcae5e48c651f60ae727fb9b1da394287be3fce686a1d9abfd61801c5d7a7632",
  "Tables": [
    {
      "Name": "page",
      "Location": "s3://prod-analytics-123456789012-us-east-1-an/warehouse/prod_analytics/page/iceberg/",
      "Columns": [
        {
          "Name": "event_id",
          "Type": "string"
        },
        {
          "Name": "event_time",
          "Type": "timestamp"
        },
        {
          "Name": "user",
          "Type": "string"
        },
        {
          "Name": "clicks",
          "Type": "bigint",
          "Default": "BIGINT '0'"
        },
        {
          "Name": "_shard",
          "Type": "string"
        },
        {
          "Name": "_seq",
          "Type": "string"
        },
        {
          "Name": "_arrival",
          "Type": "timestamp"
        }
      ]
    }
  ]
}
-- glue.json --
{
  "page": {
    "location": "s3://prod-analytics-123456789012-us-east-1-an/warehouse/prod_analytics/page/iceberg/",
    "table_type": "",
    "columns": {
      "event_id": "string",
      "event_time": "timestamp",
      "user": "string",
      "clicks": "bigint",
      "_shard": "string",
      "_seq": "string",
